[
    {
        "id": "ffe818c07b075a20",
        "type": "ui_template",
        "z": "tab-wizui",
        "group": "708d7acdaa3b72b0",
        "name": "Wizard Panel RAPIDO v1",
        "order": 2,
        "width": "15",
        "height": "7",
        "format": "<style>\n  /* ===== Botones y campos ===== */\n  .nr-btn {\n    min-height: 34px !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    border-radius: 3px !important;\n    padding: 5px 8px !important;\n    transition: transform .1s !important;\n  }\n\n  .nr-btn:active {\n    transform: scale(.96) !important;\n    opacity: .85\n  }\n\n  .nr-input {\n    height: 26px !important;\n    font-size: 13px !important;\n    padding: 1px 4px !important;\n    border: 1px solid #bbb !important;\n    border-radius: 3px !important;\n  }\n\n  /* Etiqueta izquierda (/campo) compacta */\n  code {\n    font-size: 11px !important;\n    font-weight: 600 !important;\n    min-width: 65px;\n    display: inline-block;\n    color: #666;\n  }\n\n  /* Texto explicativo del bloque */\n  .txt {\n    font-size: 12px !important;\n    margin: 1px 0 !important;\n    line-height: 1.1 !important\n  }\n\n  /* Fila de input compacta */\n  .row-compact {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    margin-bottom: 1px\n  }\n\n  /* Grids */\n  .grid-inicio {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 4px;\n    margin-bottom: 3px\n  }\n\n  .grid-opciones {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 3px;\n    margin-top: 3px\n  }\n\n  /* ===== RAPIDO v1: solo comportamiento táctil y feedback ===== */\n  /* Sin espera por doble-toque/zoom y sin selección de texto al mantener */\n  .wiz-rapido .nr-btn {\n    touch-action: manipulation;\n    -webkit-user-select: none;\n    user-select: none;\n  }\n\n  /* Feedback inmediato mientras se espera la respuesta del comando */\n  .wiz-rapido .nr-btn.is-pressed {\n    transform: scale(.96) !important;\n    opacity: .85\n  }\n\n  /* ===== Responsive ===== */\n  @media (max-width: 720px) {\n    .grid-inicio {\n      grid-template-columns: 1fr\n    }\n\n    /* botones en una columna */\n    .grid-opciones {\n      grid-template-columns: repeat(2, 1fr)\n    }\n\n    /* opciones en 2 col */\n    .nr-btn {\n      font-size: 13px !important\n    }\n\n    .nr-input {\n      height: 24px !important;\n      font-size: 12px !important\n    }\n\n    code {\n      min-width: 58px;\n      font-size: 10.5px !important\n    }\n  }\n\n  @media (max-width: 420px) {\n    .grid-opciones {\n      grid-template-columns: 1fr\n    }\n\n    /* opciones en 1 col */\n  }\n</style>\n\n<div class=\"wiz wiz-rapido\" style=\"padding:2px 6px\">\n  <div style=\"margin-bottom:3px\">\n    <button class=\"nr-btn\"\n            style=\"background:#dc3545; color:white; min-width:85px\"\n            ng-click=\"sendCmd('/__volver', $event)\">← Volver</button>\n  </div>\n\n  <div ng-if=\"vm.block\">\n\n    <!-- ===== INICIO dinámico ===== -->\n    <div ng-if=\"vm.state.current === '/inicio'\" class=\"grid-inicio\">\n\n      <!-- Clásicos con colores fijos -->\n      <button class=\"nr-btn\"\n              style=\"padding:10px; font-size:15px; background:#28a745; color:white; grid-column:1 / -1\"\n              ng-click=\"sendCmd('/cat1_COMPRAS', $event)\">🛒 COMPRAS</button>\n\n      <button class=\"nr-btn\"\n              style=\"padding:10px; font-size:15px; background:#ffc107; color:#000\"\n              ng-click=\"sendCmd('/cat1_DESPACHOS', $event)\">🚚 DESPACHOS</button>\n\n      <button class=\"nr-btn\"\n              style=\"padding:10px; font-size:15px; background:#007bff; color:white\"\n              ng-click=\"sendCmd('/cat1_PRODUCCION', $event)\">🏭 PRODUCCIÓN</button>\n\n      <!-- Extras del cuestionario: aparecen solos (lista precalculada en cada render) -->\n      <button class=\"nr-btn\"\n              style=\"padding:10px; font-size:15px; background:#6c757d; color:white\"\n              ng-repeat=\"it in v.extras track by $index\"\n              ng-click=\"sendCmd(it.cmd, $event)\">\n        {{ it.label }}\n      </button>\n    </div>\n\n    <!-- Texto del bloque (líneas descriptivas) -->\n    <div class=\"txt\" ng-repeat=\"line in vm.block.text track by $index\">{{line}}</div>\n\n    <!-- Inputs compactos: el modelo se actualiza tras 200 ms sin teclear, o al salir del campo -->\n    <div ng-repeat=\"k in vm.block.inputs track by k\" class=\"row-compact\">\n      <code>/{{k}}</code>\n      <input type=\"text\"\n             class=\"nr-input\"\n             ng-model=\"vm.state.formData[k]\"\n             ng-model-options=\"{ updateOn: 'default blur', debounce: { 'default': 200, 'blur': 0 } }\"\n             placeholder=\"/{{k}}\"\n             ng-change=\"sendInput(k, vm.state.formData[k])\"\n             style=\"flex:1\">\n    </div>\n\n    <!-- Opciones (cuando no es /inicio) -->\n    <div ng-if=\"vm.state.current !== '/inicio'\" class=\"grid-opciones\">\n      <button class=\"nr-btn\"\n              ng-repeat=\"it in v.opts track by $index\"\n              ng-click=\"sendCmd(it.cmd, $event)\">\n        {{ it.label }}\n      </button>\n    </div>\n\n  </div>\n\n  <div ng-if=\"!vm.block\" style=\"text-align:center; padding:12px; font-size:13px\">\n    Cargando...\n  </div>\n</div>\n\n<script>\n(function(scope){\n  // Wizard Panel RAPIDO v1\n  var LOCK_MS = 2500;   // timeout de seguridad del bloqueo de botones\n  var ECHO_MS = 1500;   // ventana para ignorar ecos viejos de un input recién editado\n\n  scope.vm = { block:null, state:{ current:'/inicio', formData:{} }, model:{} };\n  scope.v  = { opts:[], extras:[] };\n\n  var pending    = null;  // comando en espera de respuesta: { cmd, sig }\n  var lockTimer  = null;  // ÚNICO timer de seguridad\n  var pressedEl  = null;  // botón con feedback visual activo\n  var lastSig    = '';    // firma de la pantalla mostrada\n  var localEdits = {};    // key -> { val, t } último valor enviado por este panel\n\n  // Limpia labels de botones:\n  // - Oculta los primeros 6 chars si el texto comienza con \"/xxxxx_\" (incluye \"/prod_\", \"/prud_\", \"/cat1_\", etc.)\n  // - Quita barras iniciales residuales\n  // - Reemplaza \"_\" por espacios\n  scope.cleanLabel = function (opt) {\n    if (typeof opt !== 'string') return opt;\n\n    var s = opt.trim();\n\n    // quita \"/\" inicial\n    if (s.charAt(0) === '/') s = s.slice(1);\n\n    // recorta prefijo corto (<= 5 chars) seguido de \"_\"\n    var i = s.indexOf('_');\n    if (i > -1 && i <= 5) {\n      s = s.slice(i + 1);\n    }\n\n    // label final\n    return s.replace(/_/g, ' ').trim();\n  };\n\n  // En /inicio, mostrar solo extras (no los 3 clásicos)\n  scope.showExtraInicio = function(opt){\n    return ['/cat1_COMPRAS','/cat1_DESPACHOS','/cat1_PRODUCCION'].indexOf(opt) === -1;\n  };\n\n  function toList(x){\n    if (Array.isArray(x)) return x;\n    if (x && typeof x === 'object') return Object.keys(x).map(function(k){ return x[k]; });\n    return [];\n  }\n\n  // Precalcula botones y labels una vez por render (no en cada digest)\n  function buildView(block){\n    var opts = toList(block && block.options);\n    var all = [], extras = [];\n    for (var i = 0; i < opts.length; i++){\n      var it = { cmd: opts[i], label: scope.cleanLabel(opts[i]) };\n      all.push(it);\n      if (scope.showExtraInicio(opts[i])) extras.push(it);\n    }\n    scope.v = { opts: all, extras: extras };\n  }\n\n  // Firma de navegación: pantalla + opciones + campos.\n  // Excluye texto y formData, que cambian con inputs, directivas o lecturas de peso.\n  function navSig(state, block){\n    var cur = state && state.current;\n    try {\n      return String(cur) + '\\u0001' + JSON.stringify(block ? [block.options, block.inputs] : null);\n    } catch (e) {\n      return String(cur);\n    }\n  }\n\n  // Un render viejo (eco de un input anterior) no debe pisar lo que el operador\n  // acaba de escribir en la misma pantalla. Solo afecta la vista local.\n  function keepLocalEdits(state, prevCurrent){\n    var keys = Object.keys(localEdits);\n    if (!keys.length) return;\n    if (state.current !== prevCurrent || !state.formData || typeof state.formData !== 'object'){\n      localEdits = {};\n      return;\n    }\n    var now = Date.now();\n    for (var i = 0; i < keys.length; i++){\n      var k = keys[i], e = localEdits[k];\n      if (state.formData[k] === e.val) delete localEdits[k];          // servidor ya tiene el valor\n      else if (now - e.t < ECHO_MS) state.formData[k] = e.val;        // eco viejo: conservar lo tipeado\n      else delete localEdits[k];                                      // pasado el margen, manda el servidor\n    }\n  }\n\n  function unlock(){\n    if (lockTimer){ clearTimeout(lockTimer); lockTimer = null; }\n    pending = null;\n    if (pressedEl && pressedEl.classList) pressedEl.classList.remove('is-pressed');\n    pressedEl = null;\n  }\n\n  // Confirma de inmediato cualquier valor que siga dentro del debounce,\n  // para que el input salga ANTES que el comando.\n  function flushInputs(){\n    var a = document.activeElement;\n    if (a && a.blur && a.classList && a.classList.contains('nr-input')) a.blur();\n    if (typeof angular === 'undefined') return;\n    var els = document.querySelectorAll('.wiz-rapido input.nr-input');\n    for (var i = 0; i < els.length; i++){\n      try {\n        var c = angular.element(els[i]).controller('ngModel');\n        if (c && c.$commitViewValue) c.$commitViewValue();\n      } catch (e) {}\n    }\n  }\n\n  scope.$watch('msg', function(msg){\n    if (!msg || !msg.payload) return;\n    if (msg.payload.type === 'render'){\n      var prevCurrent = scope.vm.state && scope.vm.state.current;\n      if (msg.payload.state) keepLocalEdits(msg.payload.state, prevCurrent);\n      scope.vm.block  = msg.payload.block;\n      scope.vm.state  = msg.payload.state || scope.vm.state;\n      buildView(scope.vm.block);\n      var sig = navSig(scope.vm.state, scope.vm.block);\n      // Solo un cambio real de pantalla libera el bloqueo\n      if (pending && sig !== pending.sig) unlock();\n      lastSig = sig;\n    }\n  });\n\n  scope.sendCmd = function(cmd, ev){\n    if (pending) return;                       // toque duplicado mientras se espera respuesta\n    flushInputs();\n    localEdits = {};                           // tras un comando, el estado del servidor manda\n    pending = { cmd: cmd, sig: lastSig };\n    pressedEl = (ev && ev.currentTarget) || null;\n    if (pressedEl && pressedEl.classList) pressedEl.classList.add('is-pressed');\n    if (lockTimer) clearTimeout(lockTimer);\n    lockTimer = setTimeout(unlock, LOCK_MS);\n    scope.send({ payload:{ type:'cmd', cmd:cmd } });\n  };\n\n  scope.sendInput = function(key, val){\n    if (val == null) return;\n    localEdits[key] = { val: val, t: Date.now() };\n    scope.send({ payload:{ type:'input', key:key, value:val } });\n  };\n\n  scope.$on('$destroy', function(){\n    unlock();\n    localEdits = {};\n  });\n})(scope);\n</script>\n",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
