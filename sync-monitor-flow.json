[
    {
        "id": "b7c58dffb7e8f3ca",
        "type": "ui_template",
        "z": "1835083619a3dfa1",
        "group": "95997da83302ab47",
        "name": "Sync Monitor - Resumen",
        "order": 1,
        "width": "36",
        "height": "8",
        "format": "<style>\n  .sync-hero {\n    width: 100%;\n    padding: 18px;\n    border-radius: 18px;\n    background: linear-gradient(135deg, #0b1220 0%, #111827 55%, #172554 100%);\n    color: #e5eefb;\n    border: 1px solid rgba(148, 163, 184, 0.18);\n    box-shadow: 0 10px 30px rgba(2, 6, 23, 0.35);\n    box-sizing: border-box;\n  }\n\n  .sync-hero-top {\n    display: flex;\n    justify-content: space-between;\n    gap: 16px;\n    flex-wrap: wrap;\n    align-items: flex-start;\n  }\n\n  .sync-hero-title {\n    font-size: 24px;\n    font-weight: 800;\n    letter-spacing: .2px;\n    margin-bottom: 6px;\n  }\n\n  .sync-hero-sub {\n    font-size: 13px;\n    color: #93c5fd;\n  }\n\n  .sync-kpis {\n    display: grid;\n    grid-template-columns: repeat(8, minmax(120px, 1fr));\n    gap: 10px;\n    margin-top: 16px;\n  }\n\n  .sync-kpi {\n    background: rgba(15, 23, 42, 0.7);\n    border: 1px solid rgba(148, 163, 184, 0.16);\n    border-radius: 14px;\n    padding: 12px;\n  }\n\n  .sync-kpi-label {\n    font-size: 11px;\n    color: #94a3b8;\n    text-transform: uppercase;\n    letter-spacing: .5px;\n    margin-bottom: 6px;\n  }\n\n  .sync-kpi-val {\n    font-size: 24px;\n    font-weight: 800;\n    line-height: 1;\n    color: #f8fafc;\n  }\n\n  .sync-sweep {\n    margin-top: 16px;\n    display: grid;\n    grid-template-columns: repeat(6, minmax(120px, 1fr));\n    gap: 10px;\n  }\n\n  .sync-progress {\n    margin-top: 16px;\n    padding: 14px;\n    border-radius: 16px;\n    background: rgba(15, 23, 42, 0.72);\n    border: 1px solid rgba(148, 163, 184, 0.16);\n  }\n\n  .sync-progress-top {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    flex-wrap: wrap;\n    margin-bottom: 10px;\n    align-items: center;\n  }\n\n  .sync-progress-label {\n    font-size: 13px;\n    color: #cbd5e1;\n  }\n\n  .sync-progress-bar {\n    height: 10px;\n    border-radius: 999px;\n    overflow: hidden;\n    background: rgba(30, 41, 59, 0.95);\n  }\n\n  .sync-progress-fill {\n    height: 100%;\n    border-radius: 999px;\n    background: linear-gradient(90deg, #22c55e 0%, #38bdf8 55%, #60a5fa 100%);\n    transition: width .25s ease;\n  }\n\n  .sync-status-row {\n    margin-top: 12px;\n    display: flex;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .sync-pill {\n    padding: 10px 12px;\n    border-radius: 999px;\n    background: rgba(15, 23, 42, 0.65);\n    border: 1px solid rgba(96, 165, 250, 0.16);\n    font-size: 12px;\n    color: #cbd5e1;\n  }\n\n  .sync-pill strong {\n    color: #f8fafc;\n  }\n\n  @media (max-width: 1200px) {\n    .sync-kpis { grid-template-columns: repeat(4, minmax(120px, 1fr)); }\n    .sync-sweep { grid-template-columns: repeat(3, minmax(120px, 1fr)); }\n  }\n\n  @media (max-width: 700px) {\n    .sync-kpis, .sync-sweep { grid-template-columns: repeat(2, minmax(120px, 1fr)); }\n  }\n</style>\n\n<div class=\"sync-hero\" ng-if=\"msg && msg.payload\">\n  <div class=\"sync-hero-top\">\n    <div>\n      <div class=\"sync-hero-title\">Sync Monitor</div>\n      <div class=\"sync-hero-sub\">Barrido incremental con persistencia post reboot y vuelta automatica al registro mas nuevo</div>\n    </div>\n    <div class=\"sync-hero-sub\">Ultima actualizacion: {{msg.payload.ultimaActualizacion || 'sin datos'}}</div>\n  </div>\n\n  <div class=\"sync-kpis\">\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Total</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.total || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Borrados</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.borrados || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Precios</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.precios || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Productos</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.productos || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Proveedor</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.proveedor || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Kilos</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.kilos || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Clasificacion</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.clasificacion || 0}}</div></div>\n    <div class=\"sync-kpi\"><div class=\"sync-kpi-label\">Tipo mov.</div><div class=\"sync-kpi-val\">{{msg.payload.resumen.tipo_movimiento || 0}}</div></div>\n  </div>\n\n  <div class=\"sync-progress\" ng-if=\"msg.sweep\">\n    <div class=\"sync-progress-top\">\n      <div class=\"sync-progress-label\">Progreso del barrido actual</div>\n      <div class=\"sync-progress-label\"><strong>{{msg.sweep.porcentaje_barrido || 0}}%</strong></div>\n    </div>\n    <div class=\"sync-progress-bar\">\n      <div class=\"sync-progress-fill\" ng-style=\"{ width: (msg.sweep.porcentaje_barrido || 0) + '%' }\"></div>\n    </div>\n    <div class=\"sync-status-row\">\n      <div class=\"sync-pill\">\n        <strong>Estado:</strong>\n        {{msg.sweep.barrido_completo ? 'ciclo completo' : 'barriendo hacia atras'}}\n      </div>\n      <div class=\"sync-pill\" ng-if=\"msg.payload.meta\">\n        <strong>Updates en cola:</strong> {{msg.payload.meta.queue_pendiente || 0}}\n      </div>\n      <div class=\"sync-pill\" ng-if=\"msg.sweep.ciclo_completado_en\">\n        <strong>Ultimo 100%:</strong> {{msg.sweep.ciclo_completado_en | date:'dd/MM/yyyy HH:mm:ss'}}\n      </div>\n    </div>\n  </div>\n\n  <div class=\"sync-sweep\" ng-if=\"msg.sweep\">\n    <div class=\"sync-pill\"><strong>Cursor:</strong> {{msg.sweep.cursor_visto}}</div>\n    <div class=\"sync-pill\"><strong>Siguiente:</strong> {{msg.sweep.cursor_siguiente}}</div>\n    <div class=\"sync-pill\"><strong>Rango:</strong> {{msg.sweep.rango_desde}} - {{msg.sweep.rango_hasta}}</div>\n    <div class=\"sync-pill\"><strong>Comparados:</strong> {{msg.sweep.comparados}}</div>\n    <div class=\"sync-pill\"><strong>Diffs:</strong> {{msg.sweep.diffs_encontrados}}</div>\n    <div class=\"sync-pill\"><strong>Max ID:</strong> {{msg.sweep.max_id}}</div>\n  </div>\n</div>\n",
        "storeOutMessages": false,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 6050,
        "y": 6180,
        "wires": [[]]
    },
    {
        "id": "91f5415e8ef38e6d",
        "type": "ui_template",
        "z": "1835083619a3dfa1",
        "group": "95997da83302ab47",
        "name": "Sync Monitor - Historial",
        "order": 2,
        "width": "36",
        "height": "24",
        "format": "<style>\n  .hist-wrap {\n    width: 100%;\n    color: #dbe5f4;\n    font-size: 13px;\n  }\n\n  .hist-toolbar {\n    position: sticky;\n    top: 0;\n    z-index: 5;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    align-items: center;\n    justify-content: space-between;\n    background: rgba(2, 6, 23, 0.97);\n    border: 1px solid rgba(51, 65, 85, 0.85);\n    border-radius: 16px;\n    padding: 12px 14px;\n    margin-bottom: 14px;\n  }\n\n  .hist-toolbar-left {\n    display: flex;\n    gap: 10px;\n    flex-wrap: wrap;\n    align-items: center;\n  }\n\n  .hist-title {\n    font-size: 16px;\n    font-weight: 800;\n    color: #f8fafc;\n    margin-right: 6px;\n  }\n\n  .hist-select,\n  .hist-input,\n  .hist-btn,\n  .hist-secondary {\n    background: #0f172a;\n    color: #dbe5f4;\n    border: 1px solid #334155;\n    border-radius: 10px;\n    padding: 9px 12px;\n    font-size: 12px;\n    outline: none;\n  }\n\n  .hist-input {\n    min-width: 260px;\n  }\n\n  .hist-btn {\n    cursor: pointer;\n    background: linear-gradient(135deg, #0f766e 0%, #155e75 100%);\n    border-color: rgba(34, 211, 238, 0.25);\n    font-weight: 700;\n  }\n\n  .hist-secondary {\n    cursor: pointer;\n  }\n\n  .hist-meta {\n    color: #93c5fd;\n    font-size: 12px;\n  }\n\n  .hist-list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    max-height: 1400px;\n    overflow-y: auto;\n    padding-right: 6px;\n  }\n\n  .hist-card {\n    background: linear-gradient(180deg, #0b1220 0%, #101a2d 100%);\n    border: 1px solid rgba(51, 65, 85, 0.88);\n    border-radius: 18px;\n    overflow: hidden;\n    box-shadow: 0 10px 24px rgba(2, 6, 23, 0.18);\n  }\n\n  /* FIX: flexbox en vez de grid con columnas fijas en px */\n  .hist-summary {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    align-items: flex-start;\n    padding: 14px 16px;\n  }\n\n  .hist-meta-col {\n    flex: 0 0 240px;\n    width: 240px;\n    min-width: 0;\n  }\n\n  .hist-stamp {\n    font-size: 11px;\n    color: #64748b;\n    margin-bottom: 6px;\n  }\n\n  .hist-badges {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    margin-bottom: 6px;\n  }\n\n  .hist-badge {\n    display: inline-flex;\n    align-items: center;\n    padding: 4px 9px;\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .2px;\n  }\n\n  .hist-badge.id { background: #1d4ed8; color: #dbeafe; }\n  .hist-badge.mod { background: #5b3a06; color: #fde68a; }\n  .hist-badge.del { background: #7f1d1d; color: #fecaca; }\n  .hist-badge.cat { background: #1e3a8a; color: #dbeafe; }\n  .hist-badge.sub { background: #1e293b; color: #cbd5e1; }\n\n  .hist-text {\n    flex: 1 1 260px;\n    min-width: 0;\n  }\n\n  .hist-message {\n    padding: 12px 14px;\n    border-radius: 12px;\n    font-size: 14px;\n    line-height: 1.4;\n    font-weight: 700;\n    word-break: break-word;\n    color: #cbd5e1;\n    background: rgba(15, 23, 42, 0.6);\n  }\n\n  .hist-message.add { background: rgba(6, 78, 59, 0.78); color: #a7f3d0; }\n  .hist-message.upd { background: rgba(120, 53, 15, 0.68); color: #fde68a; }\n  .hist-message.del { background: rgba(127, 29, 29, 0.72); color: #fecaca; }\n\n  .hist-actions {\n    flex: 0 0 auto;\n    display: flex;\n    justify-content: flex-end;\n    align-items: center;\n  }\n\n  .hist-toggle {\n    cursor: pointer;\n    border: 1px solid rgba(59, 130, 246, 0.28);\n    background: rgba(15, 23, 42, 0.95);\n    color: #cfe3ff;\n    border-radius: 10px;\n    padding: 9px 12px;\n    font-size: 12px;\n    font-weight: 700;\n  }\n\n  .hist-detail {\n    border-top: 1px solid rgba(30, 41, 59, 0.82);\n    padding: 12px 16px 16px;\n    display: grid;\n    gap: 12px;\n  }\n\n  .hist-box {\n    background: rgba(15, 23, 42, 0.72);\n    border: 1px solid rgba(51, 65, 85, 0.75);\n    border-radius: 14px;\n    padding: 12px;\n  }\n\n  .hist-box-title {\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: .5px;\n    color: #94a3b8;\n    margin-bottom: 8px;\n    font-weight: 800;\n  }\n\n  .hist-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 8px;\n  }\n\n  .hist-item {\n    padding: 10px 12px;\n    border-radius: 12px;\n    background: rgba(2, 6, 23, 0.45);\n    border: 1px solid rgba(51, 65, 85, 0.65);\n  }\n\n  .hist-item-title {\n    font-size: 11px;\n    color: #64748b;\n    text-transform: uppercase;\n    font-weight: 700;\n    margin-bottom: 5px;\n  }\n\n  .hist-item-line {\n    font-size: 12px;\n    color: #cbd5e1;\n    line-height: 1.35;\n    margin-bottom: 3px;\n  }\n\n  .hist-item-line strong {\n    color: #f8fafc;\n  }\n\n  .hist-empty {\n    padding: 26px;\n    text-align: center;\n    border: 1px dashed #334155;\n    border-radius: 18px;\n    color: #64748b;\n    background: rgba(15, 23, 42, 0.5);\n  }\n\n  @media (max-width: 1100px) {\n    .hist-summary {\n      flex-direction: column;\n    }\n    .hist-meta-col {\n      width: 100%;\n      flex: 0 0 100%;\n    }\n    .hist-actions {\n      justify-content: flex-start;\n    }\n  }\n\n  @media (max-width: 760px) {\n    .hist-input {\n      min-width: 100%;\n    }\n    .hist-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"hist-wrap\" ng-init=\"ui = ui || { filtro: 'todos', texto: '', limite: 80 }\">\n  <div class=\"hist-toolbar\">\n    <div class=\"hist-toolbar-left\">\n      <div class=\"hist-title\">Historial de diferencias</div>\n      <select class=\"hist-select\" ng-model=\"ui.filtro\" ng-change=\"rebuildRows()\">\n        <option value=\"todos\">Todas las diferencias</option>\n        <option value=\"registro_borrado\">Borrados</option>\n        <option value=\"cambio_precio\">Precio</option>\n        <option value=\"cambio_producto\">Producto</option>\n        <option value=\"cambio_proveedor\">Proveedor</option>\n        <option value=\"cambio_kilos\">Kilos</option>\n        <option value=\"cambio_clasificacion\">Clasificacion</option>\n        <option value=\"cambio_tipo_movimiento\">Tipo movimiento</option>\n        <option value=\"otros_cambios\">Otros</option>\n      </select>\n      <input class=\"hist-input\" type=\"text\" ng-model=\"ui.texto\" ng-model-options=\"{ debounce: 250 }\" ng-change=\"rebuildRows()\" placeholder=\"Buscar por ID, descripcion, proveedor, lote...\" />\n      <button class=\"hist-btn\" ng-click=\"descargarTXT()\">Descargar TXT</button>\n      <button class=\"hist-secondary\" ng-if=\"rows.filtered.length > rows.limit\" ng-click=\"mostrarMas()\">Mostrar mas</button>\n    </div>\n    <div class=\"hist-meta\">{{rows.visible.length}} de {{rows.filtered.length}} resultado(s)</div>\n  </div>\n\n  <div class=\"hist-list\" ng-if=\"rows.visible.length\">\n    <div class=\"hist-card\" ng-repeat=\"entry in rows.visible track by $index\">\n      <div class=\"hist-summary\">\n        <div class=\"hist-meta-col\">\n          <div class=\"hist-stamp\">{{entry.ts}}</div>\n          <div class=\"hist-badges\">\n            <span class=\"hist-badge id\">ID {{entry.id}}</span>\n            <span class=\"hist-badge\" ng-class=\"entry.tipo === 'BORRADO' ? 'del' : 'mod'\">{{entry.tipo}}</span>\n            <span class=\"hist-badge cat\">{{entry.categoria || 'otros_cambios'}}</span>\n          </div>\n          <div class=\"hist-badges\" ng-if=\"entry.subcategorias && entry.subcategorias.length\">\n            <span class=\"hist-badge sub\" ng-repeat=\"sub in entry.subcategorias track by $index\">{{sub}}</span>\n          </div>\n        </div>\n\n        <div class=\"hist-text\">\n          <div class=\"hist-message\" ng-class=\"entry._tone\">\n            {{entry._summary}}\n          </div>\n        </div>\n\n        <div class=\"hist-actions\">\n          <button class=\"hist-toggle\" ng-click=\"toggleEntry(entry)\">\n            {{entry._open ? 'Ocultar' : 'Ver detalle'}}\n          </button>\n        </div>\n      </div>\n\n      <div class=\"hist-detail\" ng-if=\"entry._open\">\n        <div class=\"hist-box\" ng-if=\"entry.detalle_campos && entry.detalle_campos.length\">\n          <div class=\"hist-box-title\">Detalle campo por campo</div>\n          <div class=\"hist-grid\">\n            <div class=\"hist-item\" ng-repeat=\"d in entry.detalle_campos track by $index\">\n              <div class=\"hist-item-title\">{{labels[d.campo] || d.campo}}</div>\n              <div class=\"hist-item-line\"><strong>Tipo:</strong> {{d.accion}}</div>\n              <div class=\"hist-item-line\"><strong>Local:</strong> {{mostrar(d.local)}}</div>\n              <div class=\"hist-item-line\"><strong>Origen:</strong> {{mostrar(d.origen)}}</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"hist-box\" ng-if=\"entry._sourcePairs.length\">\n          <div class=\"hist-box-title\">Snapshot origen</div>\n          <div class=\"hist-grid\">\n            <div class=\"hist-item\" ng-repeat=\"pair in entry._sourcePairs track by $index\">\n              <div class=\"hist-item-title\">{{labels[pair.key] || pair.key}}</div>\n              <div class=\"hist-item-line\">{{pair.value}}</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"hist-empty\" ng-if=\"!rows.visible.length\">\n    Sin diferencias guardadas todavia. Cuando aparezcan cambios, este historial queda persistido para volver despues de un reboot.\n  </div>\n</div>\n\n<script>\n(function(scope){\n  scope.labels = {\n    NroLote:'Nro lote',\n    TiposDeMovimiento:'Tipo movimiento',\n    UnidadMedida:'Unidad medida',\n    kilos:'Kilos',\n    FechaHora:'Fecha/hora',\n    Fecha:'Fecha',\n    Hora:'Hora',\n    Descuento:'Descuento',\n    kilosNetos:'Kilos netos',\n    Proveedor:'Proveedor',\n    Materiales:'Material',\n    Description:'Descripcion',\n    Operador:'Operador',\n    Maquina:'Maquina',\n    Cat10:'Cat 10',\n    Cat11:'Cat 11',\n    Cat12:'Cat 12',\n    IF:'IF',\n    NroEnsayo:'Nro ensayo',\n    KgsRedond:'Kgs redond',\n    KgsRedondMenos:'Kgs redond-',\n    Lote:'Lote',\n    SegsEmbud:'Segs embud',\n    Precio:'Precio',\n    FechaEnsayo:'Fecha ensayo',\n    SegsFormulario:'Segs formulario',\n    ID_Bolson:'ID bolson',\n    User_Bot:'Usuario bot',\n    Descuento2:'Descuento 2',\n    fechaDespacho:'Fecha despacho',\n    userDespacho:'Usuario despacho',\n    ReClas:'Reclasificacion'\n  };\n\n  scope.ui = scope.ui || { filtro: 'todos', texto: '', limite: 80 };\n  scope.rows = scope.rows || { filtered: [], visible: [], limit: 80 };\n\n  scope.mostrar = function(v) {\n    if (v === null || v === undefined || v === '') return 'vacio';\n    return v;\n  };\n\n  scope.resumenEntry = function(entry) {\n    var descs = Array.isArray(entry.descripciones) ? entry.descripciones : [];\n    return descs.length ? descs[0] : ((entry.tipo || '') === 'BORRADO' ? 'registro borrado en origen - conservado en local' : 'cambio detectado');\n  };\n\n  scope.toneEntry = function(entry) {\n    var text = scope.resumenEntry(entry).toLowerCase();\n    if (text.indexOf('registro borrado') === 0 || text.indexOf('se quito') === 0) return 'del';\n    if (text.indexOf('se actualizo') === 0) return 'upd';\n    return 'add';\n  };\n\n  scope.sourcePairs = function(entry) {\n    var out = [];\n    var data = entry && entry.datos_origen ? entry.datos_origen : {};\n    Object.keys(data).forEach(function(k) {\n      var v = data[k];\n      if (k === 'idTiposDeMovimiento' || v === null || v === undefined || v === '') return;\n      out.push({ key: k, value: String(v) });\n    });\n    return out.slice(0, 8);\n  };\n\n  scope.decorateEntry = function(entry) {\n    entry._summary = scope.resumenEntry(entry);\n    entry._tone = scope.toneEntry(entry);\n    entry._sourcePairs = scope.sourcePairs(entry);\n    entry._open = false;\n    return entry;\n  };\n\n  scope.coincideTexto = function(entry, texto) {\n    if (!texto) return true;\n    texto = String(texto).toLowerCase().trim();\n    if (!texto) return true;\n\n    var partes = [];\n    partes.push(String(entry.id || ''));\n    partes.push(String(entry.tipo || ''));\n    partes.push(String(entry.categoria || ''));\n    partes.push((entry.subcategorias || []).join(' '));\n    partes.push((entry.descripciones || []).join(' '));\n\n    var datos = entry.datos_origen || {};\n    Object.keys(datos).forEach(function(k) {\n      partes.push(String(datos[k]));\n    });\n\n    return partes.join(' ').toLowerCase().indexOf(texto) !== -1;\n  };\n\n  scope.obtenerFiltrados = function() {\n    var payload = scope.msg && scope.msg.payload;\n    var items = payload && Array.isArray(payload.items) ? payload.items : [];\n    var filtro = scope.ui && scope.ui.filtro ? scope.ui.filtro : 'todos';\n    var texto = scope.ui && scope.ui.texto ? scope.ui.texto : '';\n\n    return items.filter(function(entry) {\n      var okFiltro = filtro === 'todos' || (entry.categoria || 'otros_cambios') === filtro;\n      return okFiltro && scope.coincideTexto(entry, texto);\n    }).map(scope.decorateEntry);\n  };\n\n  scope.rebuildRows = function() {\n    var payload = scope.msg && scope.msg.payload;\n    var renderLimit = payload && payload.meta && payload.meta.render_limit ? Number(payload.meta.render_limit) : 80;\n    if (!renderLimit || renderLimit < 1) renderLimit = 80;\n\n    scope.rows.limit = Math.max(renderLimit, scope.ui.limite || 80);\n    scope.rows.filtered = scope.obtenerFiltrados();\n    scope.rows.visible = scope.rows.filtered.slice(0, scope.rows.limit);\n  };\n\n  scope.mostrarMas = function() {\n    scope.rows.limit += 80;\n    scope.rows.visible = scope.rows.filtered.slice(0, scope.rows.limit);\n  };\n\n  scope.toggleEntry = function(entry) {\n    entry._open = !entry._open;\n  };\n\n  scope.armarTextoExportacion = function() {\n    var rows = scope.rows.filtered || [];\n    var out = [];\n    out.push('SYNC MONITOR - HISTORIAL DE DIFERENCIAS');\n    out.push('Filtro: ' + ((scope.ui && scope.ui.filtro) || 'todos'));\n    out.push('Texto: ' + ((scope.ui && scope.ui.texto) || '(sin filtro)'));\n    out.push('Cantidad: ' + rows.length);\n    out.push('Generado: ' + new Date().toLocaleString('es-AR'));\n    out.push('============================================================');\n    out.push('');\n\n    rows.forEach(function(entry, idx) {\n      out.push('Registro #' + (idx + 1));\n      out.push('ID: ' + (entry.id || ''));\n      out.push('Fecha/Hora: ' + (entry.ts || ''));\n      out.push('Tipo: ' + (entry.tipo || ''));\n      out.push('Categoria: ' + (entry.categoria || 'otros_cambios'));\n      if (entry.subcategorias && entry.subcategorias.length) out.push('Subcategorias: ' + entry.subcategorias.join(' | '));\n      out.push('');\n      out.push('Cambios detectados:');\n      (entry.descripciones || []).forEach(function(desc) { out.push('- ' + desc); });\n      if (entry.detalle_campos && entry.detalle_campos.length) {\n        out.push('');\n        out.push('Detalle campo por campo:');\n        entry.detalle_campos.forEach(function(d) {\n          out.push('- ' + ((scope.labels[d.campo] || d.campo)) + ' [' + d.accion + ']');\n          out.push('  local: ' + scope.mostrar(d.local));\n          out.push('  origen: ' + scope.mostrar(d.origen));\n        });\n      }\n      out.push('');\n      out.push('Snapshot origen:');\n      Object.keys(entry.datos_origen || {}).forEach(function(k) {\n        var v = entry.datos_origen[k];\n        if (k === 'idTiposDeMovimiento' || v === null || v === undefined || v === '') return;\n        out.push('- ' + (scope.labels[k] || k) + ': ' + v);\n      });\n      out.push('');\n      out.push('------------------------------------------------------------');\n      out.push('');\n    });\n\n    return out.join('\\n');\n  };\n\n  scope.descargarTXT = function() {\n    try {\n      var texto = scope.armarTextoExportacion();\n      var now = new Date();\n      function pad(n) { return String(n).padStart(2, '0'); }\n      var nombre = 'sync_historial_' + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + '_' + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds()) + '.txt';\n      var blob = new Blob([texto], { type: 'text/plain;charset=utf-8' });\n      var url = window.URL.createObjectURL(blob);\n      var a = document.createElement('a');\n      a.href = url;\n      a.download = nombre;\n      document.body.appendChild(a);\n      a.click();\n      document.body.removeChild(a);\n      setTimeout(function(){ window.URL.revokeObjectURL(url); }, 1000);\n    } catch (e) {\n      console.error('Error exportando historial:', e);\n      alert('No se pudo exportar el historial');\n    }\n  };\n\n  scope.$watch('msg', function() {\n    scope.rebuildRows();\n  });\n})(scope);\n</script>\n",
