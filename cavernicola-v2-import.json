[
    {
        "id": "4a453fe6b307a5fa",
        "type": "ui_template",
        "z": "8b27e6e670a085da",
        "group": "cavernicola_v2_group",
        "name": "Tablero Cavernicola v2",
        "order": 10,
        "width": "42",
        "height": "30",
        "format": "<!--\n  ===================================================================\n  TABLERO CAVERNICOLA v2  ·  UI TEMPLATE (Node-RED dashboard)\n  -------------------------------------------------------------------\n  Pegar TODO este contenido dentro del nodo ui_template\n  \"Tablero Cavernicola v2\".\n  Ancho recomendado del nodo y del grupo: 42  (alto: 30+).\n  No cambia ninguna accion send({...}) ni el nodo funcion:\n  solo mejora tortas, tarjetas, semaforo stock vs minimo y layout.\n  ===================================================================\n-->\n<style>\n.cav2{\n  --bg:#0b1120; --panel:#0f1a2e; --panel2:#0b1526; --line:rgba(148,163,184,.18);\n  --line2:rgba(148,163,184,.28); --txt:#e5edf7; --muted:#93a4bd; --muted2:#64748b;\n  --blue:#38bdf8; --cyan:#67e8f9; --green:#34d399; --yellow:#f59e0b; --red:#f87171;\n  --violet:#a78bfa; --verde:#22c55e; --amarillo:#f59e0b; --rojo:#ef4444; --azul:#38bdf8; --gris:#64748b;\n  font-family:'Segoe UI',Roboto,Arial,sans-serif;background:linear-gradient(180deg,#0b1120,#0d1526);\n  color:var(--txt);padding:14px;border-radius:12px;border:1px solid var(--line);font-size:13px;\n}\n.cav2 *{box-sizing:border-box}\n\n/* ===== HEADER ===== */\n.cav2-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;\n  border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:16px;flex-wrap:wrap}\n.cav2-title{font-size:26px;font-weight:900;letter-spacing:.2px;\n  background:linear-gradient(90deg,#67e8f9,#a78bfa);-webkit-background-clip:text;background-clip:text;color:transparent}\n.cav2-sub{font-size:12.5px;color:var(--muted);margin-top:4px;max-width:640px;line-height:1.4}\n.head-right{display:flex;flex-direction:column;align-items:flex-end;gap:8px}\n.cav2-pill{border:1px solid rgba(103,232,249,.35);border-radius:999px;padding:6px 14px;\n  color:#a5f3fc;font-size:13px;font-weight:800;background:rgba(103,232,249,.08)}\n.top-actions{display:flex;flex-wrap:wrap;gap:7px;justify-content:flex-end}\n.top-actions button{height:32px;padding:0 12px;border-radius:8px;border:1px solid rgba(56,189,248,.32);\n  background:rgba(56,189,248,.10);color:#7dd3fc;font-weight:800;font-size:12px;cursor:pointer;transition:.15s}\n.top-actions button:hover{background:rgba(56,189,248,.20);transform:translateY(-1px)}\n.top-actions .save{border-color:rgba(52,211,153,.42);background:rgba(52,211,153,.12);color:#86efac}\n.top-actions .download{border-color:rgba(167,139,250,.42);background:rgba(167,139,250,.12);color:#c4b5fd}\n\n.notice{margin-bottom:14px;padding:10px 14px;border-radius:8px;background:rgba(52,211,153,.10);\n  border:1px solid rgba(52,211,153,.25);color:#86efac;font-size:12.5px;font-weight:600}\n\n/* ===== KPIs ===== */\n.kpis{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:12px;margin-bottom:16px}\n.kpi{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:10px;\n  padding:14px 16px;overflow:hidden}\n.kpi::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px}\n.kpi.k-blue::before{background:var(--blue)}.kpi.k-green::before{background:var(--green)}\n.kpi.k-violet::before{background:var(--violet)}.kpi.k-red::before{background:var(--red)}\n.kpi .label{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:800}\n.kpi .val{font-size:28px;font-weight:900;margin-top:6px;line-height:1}\n.blue{color:var(--blue)}.green{color:var(--green)}.yellow{color:var(--yellow)}.red{color:var(--red)}.violet{color:var(--violet)}\n\n/* ===== SECTIONS ===== */\n.section{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:14px}\n.section-title{display:flex;align-items:center;gap:8px;font-size:13.5px;text-transform:uppercase;\n  letter-spacing:.5px;color:#93c5fd;font-weight:900;margin-bottom:12px}\n.section-title::before{content:\"\";width:8px;height:8px;border-radius:2px;background:#93c5fd}\n\n/* ===== SEMAFORO LEGEND ===== */\n.sem-legend{display:flex;gap:14px;flex-wrap:wrap;margin:2px 0 12px;font-size:11px;color:var(--muted)}\n.sem-legend span{display:inline-flex;align-items:center;gap:6px;font-weight:700}\n.sem-dot{width:11px;height:11px;border-radius:50%;box-shadow:0 0 8px currentColor}\n.sem-dot.verde{background:var(--verde);color:var(--verde)}\n.sem-dot.amarillo{background:var(--amarillo);color:var(--amarillo)}\n.sem-dot.rojo{background:var(--rojo);color:var(--rojo)}\n.sem-dot.azul{background:var(--azul);color:var(--azul)}\n.sem-dot.gris{background:var(--gris);color:var(--gris)}\n\n/* ===== PANELES / SECTORES ===== */\n.add-rama{height:34px;padding:0 16px;border-radius:8px;border:1px solid rgba(52,211,153,.45);\n  background:rgba(52,211,153,.12);color:#86efac;font-weight:800;cursor:pointer;margin-bottom:14px;font-size:13px}\n.add-rama:hover{background:rgba(52,211,153,.22)}\n.panel-grid{column-count:4;column-gap:12px}\n.sector{background:linear-gradient(180deg,var(--panel2),#0a1322);border:1px solid var(--line2);\n  border-radius:11px;padding:11px;break-inside:avoid;margin:0 0 12px;display:inline-block;width:100%;\n  position:relative;overflow:hidden}\n.sector::before{content:\"\";position:absolute;left:0;right:0;top:0;height:4px}\n.sector.limbo::before{background:linear-gradient(90deg,#f87171,#fb923c)}\n.sector.plan::before{background:linear-gradient(90deg,#34d399,#22d3ee)}\n.sector.control::before{background:linear-gradient(90deg,#a78bfa,#818cf8)}\n.sector-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin:5px 0 9px}\n.sector-name-edit{width:100%;min-width:0;background:transparent;border:1px solid transparent;border-radius:6px;\n  color:var(--txt);font-size:21px;font-weight:900;padding:2px 5px;margin:-2px -5px}\n.sector-name-edit:focus{background:#0d1728;border-color:rgba(56,189,248,.45);outline:none}\n.sector-name-save{height:22px;border-radius:5px;border:1px solid rgba(56,189,248,.3);\n  background:rgba(56,189,248,.08);color:#7dd3fc;font-size:10px;font-weight:800;cursor:pointer;margin-top:5px;padding:0 8px}\n.sector-id{display:inline-block;font-size:10px;border:1px solid var(--line2);border-radius:999px;\n  padding:3px 9px;color:var(--muted);margin-top:6px;font-weight:700}\n.sector-total{text-align:right;white-space:nowrap}\n.sector-total .num{font-size:27px;font-weight:900;color:var(--cyan);line-height:1}\n.sector-total .unit{font-size:13px;color:var(--muted);font-weight:700}\n.sector-health{display:inline-block;margin-top:6px;font-size:10px;font-weight:800;border-radius:999px;padding:3px 8px}\n.sector-health.ok{color:#86efac;background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.3)}\n.sector-health.def{color:#fca5a5;background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.3)}\n\n/* ===== DONUT ===== */\n.pie-box{display:grid;grid-template-columns:104px 1fr;gap:12px;align-items:center;\n  border:1px solid var(--line);border-radius:10px;padding:10px;margin:5px 0 9px;background:rgba(8,14,26,.55)}\n.donut-wrap{position:relative;width:104px;height:104px}\n.donut{width:104px;height:104px;border-radius:50%;\n  -webkit-mask:radial-gradient(closest-side,transparent 61%,#000 62%);\n  mask:radial-gradient(closest-side,transparent 61%,#000 62%)}\n.donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}\n.donut-center .dc-num{font-size:19px;font-weight:900;color:var(--txt);line-height:1}\n.donut-center .dc-unit{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:1px}\n.pie-legend{display:grid;gap:6px}\n.pie-line{display:grid;grid-template-columns:12px 1fr auto;gap:8px;align-items:center;font-size:12.5px;color:#cbd5e1}\n.pie-dot{width:11px;height:11px;border-radius:3px}\n.pie-line b{font-weight:800;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pie-line .pct{color:var(--cyan);font-weight:900}\n\n/* ===== SUBGROUP ===== */\n.sector-empty{font-size:11.5px;color:var(--muted2);padding:6px 0}\n.subgroup{background:rgba(8,14,26,.75);border:1px solid var(--line);border-left:4px solid var(--gris);\n  border-radius:9px;padding:10px;margin-top:9px}\n.subgroup.verde{border-left-color:var(--verde)}\n.subgroup.amarillo{border-left-color:var(--amarillo)}\n.subgroup.rojo{border-left-color:var(--rojo)}\n.subgroup.gris{border-left-color:var(--gris)}\n.subgroup-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;\n  border-bottom:1px solid var(--line);padding-bottom:6px;margin-bottom:7px}\n.subgroup-id{font-size:10px;color:#c4b5fd;font-weight:800;text-transform:uppercase;letter-spacing:.5px;margin-bottom:1px}\n.subgroup-title{display:flex;align-items:center;gap:8px;font-size:17.5px;font-weight:900;color:#f5f3ff;line-height:1.1}\n.subgroup-total{text-align:right;font-size:21px;font-weight:900;color:var(--cyan);white-space:nowrap;line-height:1}\n.subgroup-total small{display:block;color:var(--muted);font-size:9.5px;text-transform:uppercase;margin-top:1px;font-weight:700}\n\n/* medidor stock vs minimo */\n.stock-meter{margin:6px 0 7px}\n.stock-meter-top{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.3px}\n.stock-meter-top b{display:block;color:var(--txt);font-size:16px;text-transform:none;margin-top:1px;font-weight:800}\n.stock-meter-top .faltante b{color:var(--red)}\n.meter-bar{position:relative;height:13px;background:#16233a;border-radius:999px;overflow:hidden;margin-top:5px;border:1px solid var(--line)}\n.meter-fill{height:100%;border-radius:999px;transition:width .3s}\n.meter-fill.verde{background:linear-gradient(90deg,#16a34a,#22c55e)}\n.meter-fill.amarillo{background:linear-gradient(90deg,#d97706,#f59e0b)}\n.meter-fill.rojo{background:linear-gradient(90deg,#dc2626,#f87171)}\n.meter-fill.gris{background:linear-gradient(90deg,#475569,#64748b)}\n.meter-min{position:absolute;top:-2px;bottom:-2px;width:2px;background:#e2e8f0;opacity:.55}\n.subgroup-empty{font-size:10px;color:var(--muted2);margin-top:5px}\n\n/* materiales */\n.sector-item{border-top:1px solid rgba(148,163,184,.10);padding:8px 0;font-size:13px}\n.mat-top{display:flex;align-items:center;gap:8px}\n.mat-name{font-weight:800;flex:1;min-width:0;font-size:15px}\n.mat-badge{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.3px;border-radius:6px;padding:3px 9px;white-space:nowrap}\n.mat-row2{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:4px;flex-wrap:wrap}\n.mat-info{min-width:0;flex:1}\n.mat-badge.verde{color:#bbf7d0;background:rgba(34,197,94,.16);border:1px solid rgba(34,197,94,.35)}\n.mat-badge.amarillo{color:#fde68a;background:rgba(245,158,11,.16);border:1px solid rgba(245,158,11,.35)}\n.mat-badge.rojo{color:#fecaca;background:rgba(239,68,68,.16);border:1px solid rgba(239,68,68,.4)}\n.mat-badge.azul{color:#bae6fd;background:rgba(56,189,248,.16);border:1px solid rgba(56,189,248,.35)}\n.mat-badge.gris{color:#cbd5e1;background:rgba(100,116,139,.16);border:1px solid rgba(100,116,139,.35)}\n.mat-meta{color:var(--muted);font-size:13px;line-height:1.4}\n.mat-meta b{color:var(--txt);font-weight:800;font-variant-numeric:tabular-nums}\n.mat-obs{color:#fbbf24;font-style:italic;margin-top:2px;font-size:12.5px}\n.move-row{display:flex;gap:8px;align-items:center;flex-shrink:0}\n.rama-move,.sub-move{display:flex;gap:5px;align-items:center}\n.rama-move button,.sub-move button{height:24px;min-width:28px;border-radius:6px;font-size:11.5px;font-weight:900;cursor:pointer;padding:0 8px}\n.rama-move button{border:1px solid rgba(56,189,248,.38);background:rgba(56,189,248,.10);color:#7dd3fc}\n.sub-move button{border:1px solid rgba(167,139,250,.4);background:rgba(167,139,250,.10);color:#c4b5fd}\n.rama-move span,.sub-move span{font-size:14px;font-weight:900;min-width:16px;text-align:center}\n.rama-move span{color:#7dd3fc}.sub-move span{color:#c4b5fd}\n\n.sub-actions{display:flex;justify-content:space-between;gap:8px;align-items:center;margin:9px 0 6px;\n  border-top:1px solid var(--line);padding-top:8px}\n.sub-actions .lbl{font-size:11px;color:var(--muted);font-weight:700}\n.sub-actions button{height:26px;border-radius:6px;border:1px solid rgba(52,211,153,.45);\n  background:rgba(52,211,153,.12);color:#86efac;font-size:11px;font-weight:800;cursor:pointer;padding:0 10px}\n.sub-edit{display:grid;grid-template-columns:30px 1fr auto;gap:6px;align-items:center;margin:5px 0}\n.sub-edit span{font-size:10px;color:#93c5fd;font-weight:900;text-align:center}\n.sub-edit input{min-width:0;background:#0d1728;border:1px solid var(--line2);border-radius:5px;color:var(--txt);height:26px;padding:0 8px;font-size:11.5px}\n.sub-edit button{height:26px;border-radius:5px;border:1px solid rgba(56,189,248,.35);background:rgba(56,189,248,.10);color:#7dd3fc;font-size:10px;font-weight:800;cursor:pointer;padding:0 9px}\n\n/* ===== CARDS (plan / bandas / controles) ===== */\n.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n.card{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:14px}\n.card.ok{border-color:rgba(52,211,153,.35)}.card.mirar{border-color:rgba(245,158,11,.35)}\n.card.comprar,.card.urgente{border-color:rgba(248,113,113,.42)}.card.frenar{border-color:rgba(245,158,11,.55)}\n.card.critico{box-shadow:inset 3px 0 0 var(--rojo)}.card.justo{box-shadow:inset 3px 0 0 var(--amarillo)}\n.card-head{display:flex;justify-content:space-between;gap:8px;align-items:center}\n.name{font-size:16px;font-weight:900}\n.state{font-size:10px;text-transform:uppercase;border-radius:999px;border:1px solid var(--line2);padding:3px 9px;color:#cbd5e1;font-weight:800}\n.bar{height:13px;background:#16233a;border-radius:999px;overflow:hidden;margin:11px 0;border:1px solid var(--line)}\n.fill{height:100%;background:linear-gradient(90deg,#16a34a,#34d399)}\n.fill.warn{background:linear-gradient(90deg,#d97706,#f59e0b)}\n.nums{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;font-size:12.5px}\n.nums span{font-weight:800}.nums b{display:block;color:var(--muted);font-size:9.5px;text-transform:uppercase;font-weight:700;margin-bottom:1px}\n.crit{font-size:11px;color:var(--muted);margin-top:9px;line-height:1.4}\n.stock-lines{margin-top:9px;border-top:1px solid var(--line);padding-top:8px}\n.stock-line{display:grid;grid-template-columns:1fr auto;gap:8px;font-size:11px;padding:4px 0}\n.stock-line b{color:var(--txt)}.stock-line small{display:block;color:var(--muted2);font-size:9.5px;margin-top:1px}\n.stock-line .sl-val{font-weight:900;text-align:right}\n.stock-line.critico .sl-val{color:var(--red)}.stock-line.justo .sl-val{color:var(--yellow)}\n.stock-line.ok .sl-val{color:var(--green)}.stock-line.alto .sl-val{color:var(--blue)}\n.band-controls{display:flex;justify-content:flex-end;gap:5px;flex-wrap:wrap;margin-top:5px}\n.band-controls button{height:22px;border-radius:5px;border:1px solid rgba(56,189,248,.35);background:rgba(56,189,248,.10);color:#7dd3fc;font-size:10px;font-weight:900;cursor:pointer;padding:0 6px}\n.band-controls .maxbtn{border-color:rgba(167,139,250,.4);background:rgba(167,139,250,.10);color:#c4b5fd}\n.btns{display:flex;gap:8px;margin-top:11px}\n.btn{border:1px solid rgba(56,189,248,.35);background:rgba(56,189,248,.10);color:#7dd3fc;border-radius:7px;height:30px;padding:0 12px;font-weight:900;cursor:pointer}\n.btn.save{border-color:rgba(52,211,153,.45);background:rgba(52,211,153,.12);color:#86efac}\n.btn.reset{border-color:rgba(245,158,11,.45);background:rgba(245,158,11,.12);color:#fbbf24}\n\n/* ===== TAREAS / FUENTES ===== */\n.task{display:grid;grid-template-columns:80px 1fr 100px;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);align-items:center}\n.task:last-child{border-bottom:0}\n.prio{font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:800}\n.task-main{font-weight:900}.task-sub{font-size:11px;color:var(--muted);margin-top:2px}\n.task-tn{text-align:right;font-weight:900;color:var(--red);font-size:15px}\n.sources{display:flex;flex-wrap:wrap;gap:8px}\n.sources span{border:1px solid var(--line2);border-radius:999px;padding:5px 12px;font-size:10.5px;text-transform:uppercase;color:var(--muted);font-weight:700}\n.sources .on{color:#86efac;border-color:rgba(52,211,153,.35);background:rgba(52,211,153,.08)}\n\n@media(max-width:1500px){.panel-grid{column-count:3}}\n@media(max-width:1100px){.panel-grid{column-count:2}.kpis{grid-template-columns:repeat(2,1fr)}.grid3{grid-template-columns:1fr 1fr}}\n@media(max-width:760px){.cav2-head{display:block}.head-right{align-items:flex-start;margin-top:10px}\n  .kpis,.grid3{grid-template-columns:1fr}.panel-grid{column-count:1}.task{grid-template-columns:1fr}.task-tn{text-align:left}}\n</style>\n\n<div class=\"cav2\" ng-if=\"msg && msg.payload\">\n  <!-- HEADER -->\n  <div class=\"cav2-head\">\n    <div>\n      <div class=\"cav2-title\">Cavernicola v2</div>\n      <div class=\"cav2-sub\">Plan principal por producto terminado + bandas configurables por material de stock. Semaforo stock vs minimo por subrama y material.</div>\n    </div>\n    <div class=\"head-right\">\n      <div class=\"cav2-pill\">📅 {{msg.payload.mesKey}}</div>\n      <div class=\"top-actions\">\n        <button ng-click=\"send({payload:{accion:'mesAnterior'}})\">◀ mes</button>\n        <button ng-click=\"send({payload:{accion:'mesSiguiente'}})\">mes ▶</button>\n        <button ng-click=\"send({payload:{accion:'ajustarObjetivoTotal',deltaTn:-10}})\">meta −10</button>\n        <button ng-click=\"send({payload:{accion:'ajustarObjetivoTotal',deltaTn:10}})\">meta +10</button>\n        <button class=\"save\" ng-click=\"send({payload:{accion:'guardarCriterio'}})\">💾 guardar JSON</button>\n        <button class=\"download\" ng-click=\"downloadCavernicolaJson()\">⬇ descargar JSON</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"notice\" ng-if=\"msg.payload.aviso\">✓ {{msg.payload.aviso}}</div>\n\n  <!-- KPIs -->\n  <div class=\"kpis\">\n    <div class=\"kpi k-blue\"><div class=\"label\">Plan mensual</div><div class=\"val blue\">{{msg.payload.meta.objetivoTotalTn | number:1}} tn</div></div>\n    <div class=\"kpi k-green\"><div class=\"label\">Ingresado</div><div class=\"val green\">{{msg.payload.meta.realTotalTn | number:1}} tn</div></div>\n    <div class=\"kpi k-violet\"><div class=\"label\">Agenda</div><div class=\"val violet\">{{msg.payload.meta.agendaTotalTn | number:1}} tn</div></div>\n    <div class=\"kpi k-red\"><div class=\"label\">Falta plan</div><div class=\"val red\">{{msg.payload.meta.faltanteTotalTn | number:1}} tn</div></div>\n  </div>\n\n  <!-- PANELES POR SECTOR -->\n  <div class=\"section\">\n    <div class=\"section-title\">Paneles por producto terminado / sector</div>\n    <div class=\"sem-legend\">\n      <span><i class=\"sem-dot verde\"></i>OK (stock ≥ minimo)</span>\n      <span><i class=\"sem-dot amarillo\"></i>Justo (80–99%)</span>\n      <span><i class=\"sem-dot rojo\"></i>Critico (&lt; 80%)</span>\n      <span><i class=\"sem-dot azul\"></i>Alto (sobre maximo)</span>\n      <span><i class=\"sem-dot gris\"></i>Sin minimo</span>\n    </div>\n    <button class=\"add-rama\" ng-click=\"send({payload:{accion:'agregarProducto'}})\">+ crear tarjeta / rama</button>\n    <div class=\"panel-grid\">\n      <div class=\"sector {{p.tipo}}\" ng-repeat=\"p in msg.payload.stockPaneles track by p.id\">\n        <div class=\"sector-head\">\n          <div style=\"flex:1;min-width:0\">\n            <input class=\"sector-name-edit\" ng-model=\"p.nombre\" placeholder=\"Nombre del producto\">\n            <button class=\"sector-name-save\" ng-click=\"send({payload:{accion:'renombrarProducto',id:p.id,nombre:p.nombre}})\">guardar nombre</button>\n            <div class=\"sector-id\">ID {{p.id}} · {{p.materiales.length}} materiales</div>\n          </div>\n          <div class=\"sector-total\">\n            <div><span class=\"num\">{{p.totalTn | number:1}}</span> <span class=\"unit\">tn</span></div>\n            <div class=\"sector-health\" ng-class=\"p.deficitTn>0?'def':'ok'\">{{p.deficitTn>0 ? ('falta '+(p.deficitTn|number:1)+' tn') : 'cubierto'}}</div>\n          </div>\n        </div>\n\n        <!-- DONUT -->\n        <div class=\"pie-box\" ng-if=\"p.subramas && p.subramas.length && p.totalTn>0\">\n          <div class=\"donut-wrap\">\n            <div class=\"donut\" ng-style=\"{background:p.pieGradient}\"></div>\n            <div class=\"donut-center\"><div class=\"dc-num\">{{p.totalTn | number:1}}</div><div class=\"dc-unit\">tn total</div></div>\n          </div>\n          <div class=\"pie-legend\">\n            <div class=\"pie-line\" ng-repeat=\"s in p.subramas | limitTo:6 track by s.id\">\n              <i class=\"pie-dot\" ng-style=\"{background:s.color}\"></i>\n              <b>{{s.nombre}}</b>\n              <span class=\"pct\">{{s.pct | number:1}}%</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"sector-empty\" ng-if=\"!p.materiales.length\">Sin materiales asignados.</div>\n\n        <!-- SUBRAMAS -->\n        <div class=\"subgroup {{semSub(s)}}\" ng-repeat=\"s in p.subramas track by s.id\">\n          <div class=\"subgroup-head\">\n            <div>\n              <div class=\"subgroup-id\">Subrama {{s.id}}</div>\n              <div class=\"subgroup-title\"><i class=\"sem-dot\" ng-class=\"semSub(s)\"></i>{{s.nombre}}</div>\n            </div>\n            <div class=\"subgroup-total\">{{s.totalTn | number:1}} tn<small>{{s.materiales.length}} materiales</small></div>\n          </div>\n          <div class=\"stock-meter\">\n            <div class=\"stock-meter-top\">\n              <span>stock<b>{{s.totalTn | number:1}} tn</b></span>\n              <span>minimo<b>{{s.minimoTn | number:1}} tn</b></span>\n              <span class=\"faltante\">faltante<b>{{s.deficitTn | number:1}} tn</b></span>\n            </div>\n            <div class=\"meter-bar\">\n              <div class=\"meter-fill\" ng-class=\"semSub(s)\" ng-style=\"{width:(s.cobertura*100)+'%'}\"></div>\n              <div class=\"meter-min\" style=\"left:100%\"></div>\n            </div>\n          </div>\n          <div class=\"subgroup-empty\" ng-if=\"!s.materiales.length\">Sin materiales en esta subrama.</div>\n\n          <!-- MATERIALES -->\n          <div class=\"sector-item\" ng-repeat=\"m in s.materiales | limitTo:40 track by m.material\">\n            <div class=\"mat-top\">\n              <span class=\"mat-name\">{{m.material}}</span>\n              <span class=\"mat-badge\" ng-class=\"semMat(m)\">{{semLabel(m)}}</span>\n            </div>\n            <div class=\"mat-row2\">\n              <div class=\"mat-info\">\n                <div class=\"mat-meta\">stock <b>{{m.stockTn | number:1}}</b> tn · mín <b>{{m.minimoTn | number:1}}</b> · máx <b>{{m.maximoTn | number:1}}</b> · {{m.familia}}</div>\n                <div class=\"mat-obs\" ng-if=\"m.obs\">✎ {{m.obs}}</div>\n              </div>\n              <div class=\"move-row\">\n                <div class=\"rama-move\">\n                  <button ng-click=\"send({payload:{accion:'ajustarProductoMaterial',material:m.material,actualId:m.productoId,deltaId:-1}})\">rama −</button>\n                  <span>{{m.productoId}}</span>\n                  <button ng-click=\"send({payload:{accion:'ajustarProductoMaterial',material:m.material,actualId:m.productoId,deltaId:1}})\">+</button>\n                </div>\n                <div class=\"sub-move\">\n                  <button ng-click=\"send({payload:{accion:'ajustarSubramaMaterial',material:m.material,productoId:p.id,actualId:m.subramaId,deltaId:-1}})\">sub −</button>\n                  <span>{{m.subramaId}}</span>\n                  <button ng-click=\"send({payload:{accion:'ajustarSubramaMaterial',material:m.material,productoId:p.id,actualId:m.subramaId,deltaId:1}})\">+</button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- config subramas -->\n        <div class=\"sub-actions\">\n          <span class=\"lbl\">Configurar subramas</span>\n          <button ng-click=\"send({payload:{accion:'agregarSubrama',productoId:p.id}})\">+ subrama</button>\n        </div>\n        <div class=\"sub-edit\" ng-repeat=\"s in p.subramas track by s.id\">\n          <span>{{s.id}}</span>\n          <input ng-model=\"s.nombre\" placeholder=\"Nombre subrama\">\n          <button ng-click=\"send({payload:{accion:'renombrarSubrama',productoId:p.id,subId:s.id,nombre:s.nombre}})\">guardar</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- PLAN 200 -->\n  <div class=\"section\">\n    <div class=\"section-title\">Plan principal 200 tn por producto terminado</div>\n    <div class=\"grid3\">\n      <div class=\"card {{p.estado}} {{p.stockEstado}}\" ng-repeat=\"p in msg.payload.plan track by p.key\">\n        <div class=\"card-head\"><div class=\"name\">{{p.nombre}}</div><div class=\"state\">{{p.estado}}</div></div>\n        <div class=\"bar\"><div class=\"fill\" ng-class=\"{warn:p.estado==='mirar'}\" ng-style=\"{width:(p.avance*100)+'%'}\"></div></div>\n        <div class=\"nums\">\n          <span><b>Objetivo</b>{{p.objetivoTn | number:1}}</span>\n          <span><b>Real+agenda</b>{{p.cubiertoTn | number:1}}</span>\n          <span><b>Falta</b>{{p.faltanteTn | number:1}}</span>\n          <span><b>Stock</b>{{p.stockTn | number:1}}</span>\n        </div>\n        <div class=\"crit\">Familias operativas incluidas: {{p.familias.join(', ')}}.</div>\n        <div class=\"stock-lines\" ng-if=\"p.componentesStock && p.componentesStock.length\">\n          <div class=\"stock-line {{c.estado}}\" ng-repeat=\"c in p.componentesStock track by c.familia\">\n            <b>{{c.material || c.familia}}<small>{{c.familia}} · min {{c.minimoTn | number:1}} · max {{c.maximoTn | number:1}} · stock {{c.stockTn | number:1}} tn</small></b>\n            <div>\n              <span class=\"sl-val\" ng-if=\"c.estado==='critico'\">faltan {{c.deficitTn | number:1}}</span>\n              <span class=\"sl-val\" ng-if=\"c.estado==='justo'\">justo</span>\n              <span class=\"sl-val\" ng-if=\"c.estado==='ok'\">ok</span>\n              <span class=\"sl-val\" ng-if=\"c.estado==='alto'\">alto {{c.excesoTn | number:1}}</span>\n              <span class=\"sl-val\" ng-if=\"c.estado==='sin_minimo'\">sin min</span>\n              <div class=\"band-controls\" ng-if=\"c.material\">\n                <button ng-click=\"send({payload:{accion:'ajustarBanda',material:c.material,campo:'minimoTn',deltaTn:-10,producto:p.key,familia:c.familia}})\">min −10</button>\n                <button ng-click=\"send({payload:{accion:'ajustarBanda',material:c.material,campo:'minimoTn',deltaTn:10,producto:p.key,familia:c.familia}})\">min +10</button>\n                <button class=\"maxbtn\" ng-click=\"send({payload:{accion:'ajustarBanda',material:c.material,campo:'maximoTn',deltaTn:-10,producto:p.key,familia:c.familia}})\">max −10</button>\n                <button class=\"maxbtn\" ng-click=\"send({payload:{accion:'ajustarBanda',material:c.material,campo:'maximoTn',deltaTn:10,producto:p.key,familia:c.familia}})\">max +10</button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"crit\">{{p.criterio}} <span ng-if=\"p.foco\">Foco: {{p.foco}}.</span></div>\n        <div class=\"btns\">\n          <button class=\"btn\" ng-click=\"send({payload:{accion:'ajustarObjetivo',key:p.key,deltaTn:-10}})\">−10</button>\n          <button class=\"btn\" ng-click=\"send({payload:{accion:'ajustarObjetivo',key:p.key,deltaTn:10}})\">+10</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"btns\">\n      <button class=\"btn save\" ng-click=\"send({payload:{accion:'guardarCriterio'}})\">Guardar criterio v2</button>\n      <button class=\"btn reset\" ng-click=\"send({payload:{accion:'resetCriterio'}})\">Restaurar criterio base</button>\n    </div>\n  </div>\n\n  <!-- BANDAS -->\n  <div class=\"section\">\n    <div class=\"section-title\">Bandas criticas de stock</div>\n    <div class=\"grid3\">\n      <div class=\"card {{b.estado}}\" ng-repeat=\"b in msg.payload.bandas track by b.key\">\n        <div class=\"card-head\"><div class=\"name\">{{b.nombre}}</div><div class=\"state\">{{b.estado}}</div></div>\n        <div class=\"nums\">\n          <span><b>Disponible</b>{{b.disponibleTn | number:1}}</span>\n          <span><b>Banda</b>{{b.minimoTn | number:1}}-{{b.maximoTn | number:1}}</span>\n          <span><b>Sugerido</b>{{b.sugeridoTn | number:1}}</span>\n        </div>\n        <div class=\"crit\">{{b.accion}}. {{b.criterio}}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- CONTROLES -->\n  <div class=\"section\" ng-if=\"msg.payload.controles && msg.payload.controles.length\">\n    <div class=\"section-title\">Bolsas de control fuera del plan 200</div>\n    <div class=\"grid3\">\n      <div class=\"card {{c.estado}}\" ng-repeat=\"c in msg.payload.controles track by c.key\">\n        <div class=\"card-head\"><div class=\"name\">{{c.nombre}}</div><div class=\"state\">{{c.estado}}</div></div>\n        <div class=\"nums\">\n          <span><b>Stock</b>{{c.stockTn | number:1}}</span>\n          <span><b>Min ref.</b>{{c.minimoTn | number:1}}</span>\n          <span><b>Deficit</b>{{c.deficitTn | number:1}}</span>\n        </div>\n        <div class=\"stock-lines\" ng-if=\"c.componentes && c.componentes.length\">\n          <div class=\"stock-line {{m.estado}}\" ng-repeat=\"m in c.componentes | limitTo:6 track by m.material\">\n            <b>{{m.material}}<small>{{m.familia}} · min {{m.minimoTn | number:1}} · max {{m.maximoTn | number:1}} · stock {{m.stockTn | number:1}} tn</small></b>\n            <div>\n              <span class=\"sl-val\" ng-if=\"m.estado==='critico'\">faltan {{m.deficitTn | number:1}}</span>\n              <span class=\"sl-val\" ng-if=\"m.estado==='ok'\">ok</span>\n              <span class=\"sl-val\" ng-if=\"m.estado==='alto'\">alto {{m.excesoTn | number:1}}</span>\n              <span class=\"sl-val\" ng-if=\"m.estado==='sin_minimo'\">sin min</span>\n              <div class=\"band-controls\">\n                <button ng-click=\"send({payload:{accion:'ajustarBanda',material:m.material,campo:'minimoTn',deltaTn:-10,producto:c.key,familia:m.familia}})\">min −10</button>\n                <button ng-click=\"send({payload:{accion:'ajustarBanda',material:m.material,campo:'minimoTn',deltaTn:10,producto:c.key,familia:m.familia}})\">min +10</button>\n                <button class=\"maxbtn\" ng-click=\"send({payload:{accion:'ajustarBanda',material:m.material,campo:'maximoTn',deltaTn:-10,producto:c.key,familia:m.familia}})\">max −10</button>\n                <button class=\"maxbtn\" ng-click=\"send({payload:{accion:'ajustarBanda',material:m.material,campo:'maximoTn',deltaTn:10,producto:c.key,familia:m.familia}})\">max +10</button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"crit\">{{c.criterio}}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- TAREAS -->\n  <div class=\"section\">\n    <div class=\"section-title\">Que llamar hoy</div>\n    <div class=\"task\" ng-repeat=\"t in msg.payload.tareas track by $index\">\n      <div class=\"prio\">P{{t.prioridad}} · {{t.tipo}}</div>\n      <div><div class=\"task-main\">{{t.titulo}}: {{t.accion}}</div><div class=\"task-sub\">{{t.motivo}}</div></div>\n      <div class=\"task-tn\">{{t.tn | number:1}} tn</div>\n    </div>\n    <div class=\"crit\" ng-if=\"!msg.payload.tareas.length\">No hay tareas de compra segun el criterio actual.</div>\n  </div>\n\n  <!-- REVISAR -->\n  <div class=\"section\" ng-if=\"msg.payload.stockRevisar && msg.payload.stockRevisar.length\">\n    <div class=\"section-title\">Materiales de stock para mapear</div>\n    <div class=\"task\" ng-repeat=\"m in msg.payload.stockRevisar | limitTo:12 track by $index\">\n      <div class=\"prio\">REVISAR</div>\n      <div><div class=\"task-main\">{{m.material}}</div><div class=\"task-sub\">familia detectada: {{m.familia}} · minimo {{m.minimoTn | number:1}} tn · stock {{m.stockTn | number:1}} tn</div></div>\n      <div class=\"task-tn\">{{m.stockTn | number:1}} tn</div>\n    </div>\n  </div>\n\n  <!-- FUENTES -->\n  <div class=\"section\">\n    <div class=\"section-title\">Fuentes conectadas</div>\n    <div class=\"sources\">\n      <span ng-class=\"{on:msg.payload.meta.fuentes.criterio}\">criterio</span>\n      <span ng-class=\"{on:msg.payload.meta.fuentes.reales}\">reales</span>\n      <span ng-class=\"{on:msg.payload.meta.fuentes.stock}\">stock</span>\n      <span ng-class=\"{on:msg.payload.meta.fuentes.agenda}\">agenda</span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(scope){\n  // Semaforo por SUBRAMA (stock vs minimo)\n  scope.semSub = function(s){\n    if(!s || !(s.minimoTn > 0)) return 'gris';\n    var c = (typeof s.cobertura === 'number') ? s.cobertura : (s.minimoTn>0 ? s.totalTn/s.minimoTn : 1);\n    if(c >= 1) return 'verde';\n    if(c >= 0.8) return 'amarillo';\n    return 'rojo';\n  };\n  // Semaforo por MATERIAL (usa estado calculado en el nodo funcion)\n  scope.semMat = function(m){\n    if(!m) return 'gris';\n    if(m.estado === 'critico') return 'rojo';\n    if(m.estado === 'alto') return 'azul';\n    if(m.estado === 'ok') return 'verde';\n    return 'gris';\n  };\n  scope.semLabel = function(m){\n    if(!m) return '';\n    if(m.estado === 'critico') return 'falta ' + (Math.round((m.deficitTn||0)*10)/10);\n    if(m.estado === 'alto') return 'alto';\n    if(m.estado === 'ok') return 'ok';\n    return 'sin min';\n  };\n\n  // Descarga JSON (igual que original)\n  scope.downloadCavernicolaJson = function(){\n    var data = angular.copy(scope.msg && scope.msg.payload ? scope.msg.payload : {});\n    var criterio = angular.copy(data.criterio || {});\n    var out = {\n      version: 2,\n      tipo: \"cavernicola_v2_criterio_export\",\n      generadoEn: new Date().toISOString(),\n      mesKey: data.mesKey || criterio.mesKey || \"\",\n      criterio: criterio,\n      stockMapeo: angular.copy(data.stockMapeo || []),\n      stockPaneles: angular.copy(data.stockPaneles || []),\n      productosTerminados: angular.copy(data.productosTerminados || []),\n      resumen: angular.copy(data.meta || {})\n    };\n    var blob = new Blob([JSON.stringify(out, null, 2)], {type: \"application/json;charset=utf-8\"});\n    var url = URL.createObjectURL(blob);\n    var a = document.createElement(\"a\");\n    a.href = url; a.download = \"cavernicola_v2_\" + (out.mesKey || \"criterio\") + \".json\";\n    document.body.appendChild(a); a.click(); a.remove();\n    setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);\n  };\n})(scope);\n</script>\n",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1230,
        "y": 190,
        "wires": [
            [
                "b6202e15966b8a59"
            ]
        ]
    }
