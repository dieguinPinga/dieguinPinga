[
    {
        "id": "49ed4fa0037e62a7",
        "type": "ui_template",
        "z": "8b27e6e670a085da",
        "group": "381624894fc2728d",
        "name": "Editor bandas v2",
        "order": 1,
        "width": "42",
        "height": "34",
        "format": "<!--\n  ===================================================================\n  EDITOR DE BANDAS (minimo / maximo) por material  ·  Cavernicola v2\n  Se alimenta del MISMO msg.payload que las tarjetas / tabla.\n  Usa las acciones que ya existen en el nodo funcion:\n    - ajustarBanda  (min/max +/-)\n    - guardarCriterio (persistir a planComprasV2.json)\n  Conectar la salida del nodo \"Cavernicola v2 - criterio simple\" aca.\n  Estado de filtros en objeto scope.bf (con punto) por el scope hijo de ng-if.\n  ===================================================================\n-->\n<style>\n.bnd{--bg:#0f172a;--head:#1b2740;--txt:#e2e8f0;--muted:#94a3b8;--muted2:#64748b;--line:#26324a;\n  --blue:#38bdf8;--violet:#a78bfa;--danger:#f87171;--ok:#34d399;\n  font-family:'Segoe UI',Roboto,Arial,sans-serif;background:var(--bg);color:var(--txt);\n  padding:14px;border-radius:10px;border:1px solid var(--line);font-size:13px}\n.bnd *{box-sizing:border-box}\n.bnd-head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap;\n  border-bottom:1px solid var(--line);padding-bottom:10px;margin-bottom:12px}\n.bnd-title{font-size:19px;font-weight:800}\n.bnd-title small{display:block;font-size:11.5px;color:var(--muted);font-weight:600;margin-top:2px}\n.bnd-mes{font-size:12px;color:#a5f3fc;border:1px solid rgba(56,189,248,.3);border-radius:999px;padding:5px 12px;font-weight:700;background:rgba(56,189,248,.07)}\n\n.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}\n.toolbar input[type=text]{height:32px;background:#0d1728;border:1px solid var(--line);border-radius:7px;color:var(--txt);font-size:13px;padding:0 10px;outline:none;min-width:210px;flex:1;max-width:320px}\n.toolbar input:focus{border-color:rgba(56,189,248,.55)}\n.chk{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted);cursor:pointer;border:1px solid var(--line);border-radius:7px;height:32px;padding:0 12px;user-select:none}\n.chk input{width:15px;height:15px;accent-color:var(--blue);cursor:pointer}\n.save-btn{height:32px;border-radius:7px;border:1px solid rgba(52,211,153,.5);background:rgba(52,211,153,.14);color:#86efac;font-weight:800;font-size:12.5px;padding:0 14px;cursor:pointer}\n.save-btn:hover{background:rgba(52,211,153,.24)}\n.count{margin-left:auto;font-size:12px;color:var(--muted);white-space:nowrap}\n.count b{color:var(--txt);font-weight:800}\n.hint{font-size:11.5px;color:var(--muted2);margin:-4px 0 10px}\n\n.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:9px}\ntable.grid{width:100%;border-collapse:collapse;min-width:760px}\n.grid thead th{position:sticky;top:0;background:var(--head);color:var(--muted);text-transform:uppercase;font-size:11px;letter-spacing:.5px;font-weight:800;text-align:left;padding:9px 11px;white-space:nowrap;border-bottom:1px solid var(--line);z-index:1}\n.grid thead th.center{text-align:center}\n.grid thead th.num{text-align:right}\n.grid tbody td{padding:8px 11px;border-bottom:1px solid rgba(38,50,74,.6);font-size:13px;vertical-align:middle}\n.grid tbody tr:nth-child(even) td{background:rgba(255,255,255,.015)}\n.grid tbody tr:hover td{background:rgba(56,189,248,.05)}\n.c-mat{font-weight:800;white-space:nowrap}\n.c-fam{display:block;font-size:11px;color:var(--muted2);font-weight:400;margin-top:1px}\n.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}\n.stock-lo{color:var(--danger);font-weight:800}\n.stock-ok{color:var(--txt);font-weight:700}\n.edit{display:flex;align-items:center;justify-content:center;gap:5px;white-space:nowrap}\n.edit .val{min-width:42px;text-align:center;font-size:15px;font-weight:800;font-variant-numeric:tabular-nums}\n.edit.min .val{color:#7dd3fc}\n.edit.max .val{color:#c4b5fd}\n.edit .nomin{color:var(--muted2);font-weight:700;font-size:12px}\n.stp{height:24px;min-width:30px;border-radius:6px;font-size:11px;font-weight:900;cursor:pointer;padding:0 6px}\n.edit.min .stp{border:1px solid rgba(56,189,248,.38);background:rgba(56,189,248,.10);color:#7dd3fc}\n.edit.max .stp{border:1px solid rgba(167,139,250,.4);background:rgba(167,139,250,.10);color:#c4b5fd}\n.stp:hover{filter:brightness(1.25)}\n.empty{padding:26px;text-align:center;color:var(--muted2)}\n.notice{margin-bottom:10px;padding:8px 12px;border-radius:7px;background:rgba(52,211,153,.10);border:1px solid rgba(52,211,153,.25);color:#86efac;font-size:12px;font-weight:600}\n</style>\n\n<div class=\"bnd\" ng-if=\"msg && msg.payload\">\n  <div class=\"bnd-head\">\n    <div class=\"bnd-title\">Editar bandas — mínimo / máximo por material\n      <small>Tocá −/+ para ajustar (se aplica al instante). Guardá para dejarlo fijo en planComprasV2.json.</small>\n    </div>\n    <div class=\"bnd-mes\">📅 {{msg.payload.mesKey}}</div>\n  </div>\n\n  <div class=\"notice\" ng-if=\"msg.payload.aviso\">✓ {{msg.payload.aviso}}</div>\n\n  <div class=\"toolbar\">\n    <input type=\"text\" ng-model=\"bf.q\" placeholder=\"🔍 Buscar material, familia, producto...\">\n    <label class=\"chk\"><input type=\"checkbox\" ng-model=\"bf.soloSinMin\"> Solo sin mínimo</label>\n    <button class=\"save-btn\" ng-click=\"send({payload:{accion:'guardarCriterio'}})\">💾 Guardar bandas</button>\n    <span class=\"count\"><b>{{bandasRows().length}}</b> materiales</span>\n  </div>\n  <div class=\"hint\">El mínimo/máximo se aplica por material; “−10 / +10” salta de a 10 tn y “−1 / +1” afina de a 1 tn.</div>\n\n  <div class=\"tbl-wrap\">\n    <table class=\"grid\">\n      <thead>\n        <tr>\n          <th>Material</th>\n          <th class=\"num\">Stock</th>\n          <th class=\"center\">Mínimo (tn)</th>\n          <th class=\"center\">Máximo (tn)</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr ng-repeat=\"r in bandasRows() track by r.material\">\n          <td><span class=\"c-mat\">{{r.material}}</span><span class=\"c-fam\">{{r.familia}}<span ng-if=\"r.producto\"> · {{r.producto}}</span></span></td>\n          <td class=\"num\" ng-class=\"(r.stockTn!=null && r.minimoTn>0 && r.stockTn<r.minimoTn)?'stock-lo':'stock-ok'\">{{r.stockTn!=null ? (r.stockTn | number:1) : '—'}}</td>\n          <td>\n            <div class=\"edit min\">\n              <button class=\"stp\" ng-click=\"ajBanda(r,'minimoTn',-10)\">−10</button>\n              <button class=\"stp\" ng-click=\"ajBanda(r,'minimoTn',-1)\">−1</button>\n              <span class=\"val\" ng-class=\"{nomin:!(r.minimoTn>0)}\">{{r.minimoTn>0 ? (r.minimoTn | number:1) : '—'}}</span>\n              <button class=\"stp\" ng-click=\"ajBanda(r,'minimoTn',1)\">+1</button>\n              <button class=\"stp\" ng-click=\"ajBanda(r,'minimoTn',10)\">+10</button>\n            </div>\n          </td>\n          <td>\n            <div class=\"edit max\">\n              <button class=\"stp\" ng-click=\"ajBanda(r,'maximoTn',-10)\">−10</button>\n              <button class=\"stp\" ng-click=\"ajBanda(r,'maximoTn',-1)\">−1</button>\n              <span class=\"val\" ng-class=\"{nomin:!(r.maximoTn>0)}\">{{r.maximoTn>0 ? (r.maximoTn | number:1) : '—'}}</span>\n              <button class=\"stp\" ng-click=\"ajBanda(r,'maximoTn',1)\">+1</button>\n              <button class=\"stp\" ng-click=\"ajBanda(r,'maximoTn',10)\">+10</button>\n            </div>\n          </td>\n        </tr>\n        <tr ng-if=\"!bandasRows().length\"><td colspan=\"4\" class=\"empty\">No hay materiales para este filtro.</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<script>\n(function(scope){\n  scope.bf = { q:'', soloSinMin:false };\n\n  function norm(x){ return (x==null?'':x).toString().trim().toUpperCase(); }\n\n  // Lista fusionada (bandas + stock) CACHEADA: se reconstruye solo cuando llega\n  // un payload nuevo (cambia generadoEn). Devolver objetos estables evita el\n  // loop de digest de AngularJS (infdig) al usarla dentro de ng-repeat.\n  scope._bandCache = null;\n  scope._bandSig = null;\n  scope.bandasBase = function(){\n    var pay = (scope.msg && scope.msg.payload) ? scope.msg.payload : {};\n    var sig = String(pay.generadoEn || '') + '|' + ((pay.criterio && pay.criterio.bandasMaterial) ? pay.criterio.bandasMaterial.length : 0);\n    if(scope._bandSig === sig && scope._bandCache) return scope._bandCache;\n    var bands = (pay.criterio && pay.criterio.bandasMaterial) ? pay.criterio.bandasMaterial : [];\n    var stock = pay.stockMapeo || [];\n    var stockByMat = {};\n    stock.forEach(function(m){ stockByMat[norm(m.material)] = m; });\n    var map = {};\n    bands.forEach(function(b){\n      var k = norm(b.material); if(!k) return;\n      var s = stockByMat[k];\n      map[k] = {\n        material: b.material,\n        familia: b.familiaOperativa || (s ? s.familia : ''),\n        producto: b.productoCompra || (s ? s.producto : ''),\n        minimoTn: Number(b.minimoTn) || 0,\n        maximoTn: Number(b.maximoTn) || 0,\n        stockTn: s ? (Number(s.stockTn) || 0) : null\n      };\n    });\n    stock.forEach(function(m){\n      var k = norm(m.material); if(!k || map[k]) return;\n      map[k] = {\n        material: m.material,\n        familia: m.familia,\n        producto: m.producto,\n        minimoTn: Number(m.minimoTn) || 0,\n        maximoTn: Number(m.maximoTn) || 0,\n        stockTn: Number(m.stockTn) || 0\n      };\n    });\n    var rows = Object.keys(map).map(function(k){ return map[k]; });\n    rows.sort(function(a,b){ return a.material.localeCompare(b.material); });\n    scope._bandSig = sig;\n    scope._bandCache = rows;\n    return rows;\n  };\n\n  scope.bandasRows = function(){\n    var tf = scope.bf, q = (tf.q||'').toString().toLowerCase().trim();\n    return scope.bandasBase().filter(function(r){\n      if(tf.soloSinMin && r.minimoTn > 0) return false;\n      if(q){ var hay = (r.material+' '+r.familia+' '+r.producto).toLowerCase(); if(hay.indexOf(q) < 0) return false; }\n      return true;\n    });\n  };\n\n  scope.ajBanda = function(r, campo, delta){\n    scope.send({ payload: {\n      accion: 'ajustarBanda',\n      material: r.material,\n      campo: campo,\n      deltaTn: delta,\n      producto: r.producto,\n      familia: r.familia\n    }});\n  };\n})(scope);\n</script>\n",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": true,
