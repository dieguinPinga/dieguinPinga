[
    {
        "id": "broker-raspi",
        "type": "mqtt-broker",
        "name": "Mosquitto RasPi",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-btc-listener",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {}
    },
    {
        "id": "mqtt-in-snapshot",
        "type": "mqtt in",
        "name": "btc/snapshot",
        "topic": "btc/snapshot",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "broker-raspi",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 120,
        "y": 160,
        "wires": [["parse-json"]]
    },
    {
        "id": "parse-json",
        "type": "json",
        "name": "parse JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 310,
        "y": 160,
        "wires": [["debug-full", "fn-resumen", "fn-precio", "fn-trend", "fn-flow"]]
    },
    {
        "id": "debug-full",
        "type": "debug",
        "name": "snapshot completo",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 530,
        "y": 80,
        "wires": []
    },
    {
        "id": "fn-resumen",
        "type": "function",
        "name": "resumen texto",
        "func": "var d = msg.payload;\nvar sign = d.pct >= 0 ? '+' : '';\nmsg.payload = 'BTC $' + d.price.toLocaleString('es-AR', {minimumFractionDigits:2}) +\n  '  ' + sign + d.pct.toFixed(3) + '%' +\n  '  flujo:' + d.flow.toFixed(4) + ' BTC/s' +\n  '  ' + d.trend +\n  '  [BIN:' + d.bin_w + '% CB:' + d.cb_w + '%]';\nreturn msg;",
        "outputs": 1,
        "x": 530,
        "y": 160,
        "wires": [["debug-resumen"]]
    },
    {
        "id": "debug-resumen",
        "type": "debug",
        "name": "resumen",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "msg",
        "x": 730,
        "y": 160,
        "wires": []
    },
    {
        "id": "fn-precio",
        "type": "change",
        "name": "precio",
        "rules": [{"t": "set", "p": "payload", "pt": "msg", "to": "payload.price", "tot": "msg"}],
        "x": 530,
        "y": 240,
        "wires": [["debug-precio"]]
    },
    {
        "id": "debug-precio",
        "type": "debug",
        "name": "precio USD",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "msg",
        "x": 730,
        "y": 240,
        "wires": []
    },
    {
        "id": "fn-trend",
        "type": "change",
        "name": "tendencia",
        "rules": [{"t": "set", "p": "payload", "pt": "msg", "to": "payload.trend", "tot": "msg"}],
        "x": 530,
        "y": 320,
        "wires": [["debug-trend"]]
    },
    {
        "id": "debug-trend",
        "type": "debug",
        "name": "tendencia",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "msg",
        "x": 730,
        "y": 320,
        "wires": []
    },
    {
        "id": "fn-flow",
        "type": "change",
        "name": "flujo BTC/s",
        "rules": [{"t": "set", "p": "payload", "pt": "msg", "to": "payload.flow", "tot": "msg"}],
        "x": 530,
        "y": 400,
        "wires": [["debug-flow"]]
    },
    {
        "id": "debug-flow",
        "type": "debug",
        "name": "flujo BTC/s",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "msg",
        "x": 730,
        "y": 400,
        "wires": []
    }
]
