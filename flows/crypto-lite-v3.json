  {
    "id": "crypto_summary",
    "type": "ui_template",
    "z": "crypto_lite_v3_tab",
    "group": "crypto_group_summary",
    "name": "Panel 4 monedas",
    "order": 1,
    "width": 12,
    "height": 4,
    "format": "<style>\n.cl-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:4px}\n.cl-tile{background:#0d1117;border:1px solid #30363d;border-radius:10px;padding:10px 12px}\n.cl-sym{font-size:12px;color:#8b949e;letter-spacing:1px;text-transform:uppercase}\n.cl-px{font-size:24px;font-weight:700;color:#e6edf3;margin-top:2px;line-height:1.1}\n.cl-row{display:flex;justify-content:space-between;align-items:baseline;margin-top:6px;font-size:12px;color:#8b949e}\n.cl-up{color:#3fb950}.cl-down{color:#f85149}.cl-flat{color:#8b949e}\n.cl-off{opacity:.4}\n.cl-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;vertical-align:middle}\n.cl-dg{background:#3fb950}.cl-dr{background:#f85149}\n.cl-na{color:#8b949e;font-size:20px}\n</style>\n<div class=\"cl-grid\">\n  <div class=\"cl-tile\" ng-class=\"{'cl-off': !msg.payload.btc || msg.payload.btc.stale}\">\n    <div class=\"cl-sym\"><span class=\"cl-dot\" ng-class=\"(msg.payload.btc && !msg.payload.btc.stale)?'cl-dg':'cl-dr'\"></span>Bitcoin</div>\n    <div class=\"cl-px\" ng-if=\"msg.payload.btc\">${{msg.payload.btc.price | number:0}}</div>\n    <div class=\"cl-na\" ng-if=\"!msg.payload.btc\">--</div>\n    <div class=\"cl-row\" ng-if=\"msg.payload.btc\">\n      <span ng-class=\"msg.payload.btc.change>0?'cl-up':(msg.payload.btc.change<0?'cl-down':'cl-flat')\">{{msg.payload.btc.change>=0?'▲':'▼'}} {{msg.payload.btc.change | number:2}}% 1h</span>\n      <span>{{msg.payload.btc.age}} s</span>\n    </div>\n  </div>\n  <div class=\"cl-tile\" ng-class=\"{'cl-off': !msg.payload.xmr || msg.payload.xmr.stale}\">\n    <div class=\"cl-sym\"><span class=\"cl-dot\" ng-class=\"(msg.payload.xmr && !msg.payload.xmr.stale)?'cl-dg':'cl-dr'\"></span>Monero</div>\n    <div class=\"cl-px\" ng-if=\"msg.payload.xmr\">${{msg.payload.xmr.price | number:2}}</div>\n    <div class=\"cl-na\" ng-if=\"!msg.payload.xmr\">--</div>\n    <div class=\"cl-row\" ng-if=\"msg.payload.xmr\">\n      <span ng-class=\"msg.payload.xmr.change>0?'cl-up':(msg.payload.xmr.change<0?'cl-down':'cl-flat')\">{{msg.payload.xmr.change>=0?'▲':'▼'}} {{msg.payload.xmr.change | number:2}}% 1h</span>\n      <span>{{msg.payload.xmr.age}} s</span>\n    </div>\n  </div>\n  <div class=\"cl-tile\" ng-class=\"{'cl-off': !msg.payload.gmx || msg.payload.gmx.stale}\">\n    <div class=\"cl-sym\"><span class=\"cl-dot\" ng-class=\"(msg.payload.gmx && !msg.payload.gmx.stale)?'cl-dg':'cl-dr'\"></span>GMX</div>\n    <div class=\"cl-px\" ng-if=\"msg.payload.gmx\">${{msg.payload.gmx.price | number:3}}</div>\n    <div class=\"cl-na\" ng-if=\"!msg.payload.gmx\">--</div>\n    <div class=\"cl-row\" ng-if=\"msg.payload.gmx\">\n      <span ng-class=\"msg.payload.gmx.change>0?'cl-up':(msg.payload.gmx.change<0?'cl-down':'cl-flat')\">{{msg.payload.gmx.change>=0?'▲':'▼'}} {{msg.payload.gmx.change | number:2}}% 1h</span>\n      <span>{{msg.payload.gmx.age}} s</span>\n    </div>\n  </div>\n  <div class=\"cl-tile\" ng-class=\"{'cl-off': !msg.payload.ltc || msg.payload.ltc.stale}\">\n    <div class=\"cl-sym\"><span class=\"cl-dot\" ng-class=\"(msg.payload.ltc && !msg.payload.ltc.stale)?'cl-dg':'cl-dr'\"></span>Litecoin</div>\n    <div class=\"cl-px\" ng-if=\"msg.payload.ltc\">${{msg.payload.ltc.price | number:2}}</div>\n    <div class=\"cl-na\" ng-if=\"!msg.payload.ltc\">--</div>\n    <div class=\"cl-row\" ng-if=\"msg.payload.ltc\">\n      <span ng-class=\"msg.payload.ltc.change>0?'cl-up':(msg.payload.ltc.change<0?'cl-down':'cl-flat')\">{{msg.payload.ltc.change>=0?'▲':'▼'}} {{msg.payload.ltc.change | number:2}}% 1h</span>\n      <span>{{msg.payload.ltc.age}} s</span>\n    </div>\n  </div>\n</div>",
