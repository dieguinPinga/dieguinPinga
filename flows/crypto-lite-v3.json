  {
    "id": "crypto_trim_proc",
    "type": "function",
    "z": "crypto_lite_v3_tab",
    "name": "Dejar ultimos N dias",
    "func": "// Deja solo los ultimos N dias en el archivo (evita que crezca sin fin)\nlet txt = msg.payload;\nif (Buffer.isBuffer(txt)) txt = txt.toString('utf8');\nif (typeof txt !== 'string' || !txt.length) return null;\n\nconst keep = Number(global.get('cryptoKeepDays')) || 7;\nconst cut = Date.now() - keep * 86400000;\n\nconst kept = [];\nfor (const ln of txt.split(/\\r?\\n/)) {\n  if (!ln) continue;\n  let o; try { o = JSON.parse(ln); } catch (e) { continue; }\n  if (!o || !Number.isFinite(o.t)) continue;\n  if (o.t < cut) continue;\n  kept.push(JSON.stringify({ t: o.t, p: o.p }));\n}\n// si no cambio la cantidad de lineas utiles, no reescribo\nmsg.payload = kept.join('\\n');\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 700,
