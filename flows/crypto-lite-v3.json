  {
    "id": "crypto_emit",
    "type": "function",
    "z": "crypto_lite_v3_tab",
    "name": "Emitir tarjetas",
    "func": "// Cada 5 s: arma el panel resumen + tarjetas de detalle (rapido, sin tocar disco)\nconst now = Date.now();\n\nfunction chg(coin, price) {                 // variacion % vs ~1 h atras\n  const ring = flow.get('hist_' + coin) || [];\n  if (!ring.length) return null;\n  const target = now - 3600000;\n  let ref = ring[0];\n  for (const pt of ring) { if (pt.t <= target) ref = pt; else break; }\n  if (!ref || !Number.isFinite(ref.p) || ref.p === 0) return null;\n  return (price - ref.p) / ref.p * 100;\n}\n\nconst map = [['btc','BTC'], ['xmr','XMR'], ['gmx','GMX'], ['ltc','LTC']];\nconst sum = {};\nconst cards = {};\n\nfor (const [k, sym] of map) {\n  const q = flow.get(k);\n  if (q && Number.isFinite(q.price)) {\n    const item = {\n      symbol: sym,\n      price:  q.price,\n      change: chg(k, q.price),\n      age:    q.ts ? Math.round((now - q.ts) / 1000) : null,\n      stale:  q.ts ? (now - q.ts > 60000) : true,\n      bid:    q.bid  != null ? q.bid  : null,\n      ask:    q.ask  != null ? q.ask  : null,\n      flow:   q.flow != null ? q.flow : null,\n      avg:    q.avg  != null ? q.avg  : null,\n      rssi:   q.rssi != null ? q.rssi : null,\n      device: q.device || null\n    };\n    sum[k] = item;\n    cards[k] = { payload: item };\n  } else {\n    sum[k] = null;\n    cards[k] = null;\n  }\n}\n\nreturn [{ payload: sum }, cards.btc, cards.xmr, cards.gmx, cards.ltc];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 380,
    "wires": [
