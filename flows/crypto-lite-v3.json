  {
    "id": "crypto_kraken_parse",
    "type": "function",
    "z": "crypto_lite_v3_tab",
    "name": "Guardar Kraken",
    "func": "// Kraken WS -> guarda ultimo ticker de XMR / GMX / LTC en flow context\nlet d;\ntry { d = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload; }\ncatch (e) { return null; }\n\nif (!Array.isArray(d)) {\n  if (d && d.event === 'subscriptionStatus') {\n    node.status({\n      fill: d.status === 'subscribed' ? 'green' : 'red',\n      shape: 'dot',\n      text: (d.pair || '') + ' ' + (d.status || '')\n    });\n  }\n  return null;\n}\n\nif (d.length < 4 || d[2] !== 'ticker') return null;\nconst t = d[1] || {};\nconst pair = String(d[3] || '');\nif (!t.c || !t.c.length) return null;\n\nconst price = Number(t.c[0]);\nif (!Number.isFinite(price) || price <= 0) return null;\n\nconst q = {\n  price: price,\n  bid: (t.b && t.b.length) ? Number(t.b[0]) : null,\n  ask: (t.a && t.a.length) ? Number(t.a[0]) : null,\n  ts: Date.now()\n};\n\nif      (pair === 'XMR/USD') flow.set('xmr', q);\nelse if (pair === 'GMX/USD') flow.set('gmx', q);\nelse if (pair === 'LTC/USD') flow.set('ltc', q);\nreturn null;",
    "outputs": 0,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 280,
    "wires": []
  },
