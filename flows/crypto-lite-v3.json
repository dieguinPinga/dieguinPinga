  {
    "id": "crypto_btc_proc",
    "type": "function",
    "z": "crypto_lite_v3_tab",
    "name": "BTC · guardar",
    "func": "// BTC via MQTT -> guarda ultimo valor en flow.btc (+ promedio de flujo 5 min)\nlet p = msg.payload;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { return null; } }\nif (!p || typeof p !== 'object') return null;\n\nconst price = Number(p.price);\nif (!Number.isFinite(price) || price < 1000) return null;\n\nconst now  = Date.now();\nconst flowv = Number(p.flow_btc_s);\nconst rssi  = Number(p.rssi);\n\nlet samples = context.get('flowSamples') || [];\nif (Number.isFinite(flowv)) samples.push({ t: now, v: flowv });\nconst cutoff = now - 300000;               // ultimos 5 min\nsamples = samples.filter(s => s.t >= cutoff);\ncontext.set('flowSamples', samples);\n\nlet avg = null;\nif (samples.length) avg = samples.reduce((a, s) => a + s.v, 0) / samples.length;\n\nflow.set('btc', {\n  price: price,\n  flow:  Number.isFinite(flowv) ? flowv : null,\n  avg:   avg,\n  rssi:  Number.isFinite(rssi) ? rssi : null,\n  device: p.device || '-',\n  ts: now\n});\nreturn null;",
    "outputs": 0,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 140,
    "wires": []
  },
