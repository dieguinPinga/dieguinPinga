  {
    "id": "crypto_seed",
    "type": "function",
    "z": "crypto_lite_v3_tab",
    "name": "Sembrar grafico",
    "func": "// Toma el archivo de una moneda y siembra el grafico con el historial guardado\nconst coin = msg.coin || '?';\nlet txt = msg.payload;\nif (Buffer.isBuffer(txt)) txt = txt.toString('utf8');\nif (typeof txt !== 'string' || !txt.length) return null;\n\nconst now = Date.now();\nconst days = Number(global.get('cryptoViewDays')) || 1;   // ventana a mostrar\nconst cut = now - days * 86400000;\n\nconst pts = [];\nfor (const ln of txt.split(/\\r?\\n/)) {\n  if (!ln) continue;\n  let o; try { o = JSON.parse(ln); } catch (e) { continue; }\n  if (!o || !Number.isFinite(o.t) || !Number.isFinite(o.p)) continue;\n  if (o.t < cut) continue;\n  pts.push({ x: o.t, y: o.p });\n}\nif (!pts.length) return null;\npts.sort((a, b) => a.x - b.x);\n\n// downsample para no ahogar al navegador de la Pi\nconst MAX = 600;\nlet ds = pts;\nif (pts.length > MAX) {\n  const step = Math.ceil(pts.length / MAX);\n  ds = pts.filter((_, i) => i % step === 0);\n}\n\n// tambien reconstruimos el ring para la variacion %\nflow.set('hist_' + coin.toLowerCase(), pts.slice(-1500).map(p => ({ t: p.x, p: p.y })));\n\nmsg.payload = [{ series: [coin], data: [ds], labels: [''] }];\nmsg.topic = coin;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 790,
    "y": 560,
    "wires": [
      [
        "crypto_seed_switch"
      ]
    ]
  },
