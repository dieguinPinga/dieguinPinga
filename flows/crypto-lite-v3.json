        "crypto_summary"
      ],
      [
        "crypto_btc_card"
      ],
      [
        "crypto_xmr_card"
      ],
      [
        "crypto_gmx_card"
      ],
      [
        "crypto_ltc_card"
      ]
    ]
  },
