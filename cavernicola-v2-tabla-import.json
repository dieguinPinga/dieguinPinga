[
    {
        "id": "ce9c86f7a7544947",
        "type": "ui_template",
        "z": "8b27e6e670a085da",
        "group": "196e0176213a395c",
        "name": "Tabla stock v2",
        "order": 1,
        "width": "42",
        "height": "30",
        "format": "<!--\n  ===================================================================\n  TABLA STOCK vs MINIMO  ·  Cavernicola v2  (vista planilla, sobria)\n  Se alimenta del MISMO msg.payload que las tarjetas (stockMapeo).\n  Conectar la salida del nodo funcion \"Cavernicola v2 - criterio simple\"\n  a este nodo ui_template.\n  Nota: todo el estado de filtros va en el objeto scope.tf (con punto)\n  para que ng-if / scope hijo no rompa los ng-model.\n  ===================================================================\n-->\n<style>\n.tbl2{--bg:#0f172a;--panel:#131c2e;--head:#1b2740;--txt:#e2e8f0;--muted:#94a3b8;--muted2:#64748b;\n  --line:#26324a;--accent:#38bdf8;--danger:#f87171;--ok:#34d399;--alto:#38bdf8;--gris:#64748b;\n  font-family:'Segoe UI',Roboto,Arial,sans-serif;background:var(--bg);color:var(--txt);\n  padding:14px;border-radius:10px;border:1px solid var(--line);font-size:13px}\n.tbl2 *{box-sizing:border-box}\n.tbl2-head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap;\n  border-bottom:1px solid var(--line);padding-bottom:10px;margin-bottom:12px}\n.tbl2-title{font-size:19px;font-weight:800;letter-spacing:.2px}\n.tbl2-title small{display:block;font-size:11.5px;color:var(--muted);font-weight:600;margin-top:2px}\n.tbl2-mes{font-size:12px;color:#a5f3fc;border:1px solid rgba(56,189,248,.3);border-radius:999px;\n  padding:5px 12px;font-weight:700;background:rgba(56,189,248,.07)}\n\n.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}\n.toolbar input[type=text],.toolbar select{height:32px;background:#0d1728;border:1px solid var(--line);\n  border-radius:7px;color:var(--txt);font-size:13px;padding:0 10px;outline:none}\n.toolbar input[type=text]{min-width:210px;flex:1;max-width:340px}\n.toolbar input:focus,.toolbar select:focus{border-color:rgba(56,189,248,.55)}\n.chk{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted);cursor:pointer;\n  border:1px solid var(--line);border-radius:7px;height:32px;padding:0 12px;user-select:none}\n.chk input{width:15px;height:15px;accent-color:var(--danger);cursor:pointer}\n.count{margin-left:auto;font-size:12px;color:var(--muted);white-space:nowrap}\n.count b{color:var(--txt);font-weight:800}\n.count .rd{color:var(--danger)}\n\n.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:9px}\ntable.grid{width:100%;border-collapse:collapse;min-width:720px}\n.grid thead th{position:sticky;top:0;background:var(--head);color:var(--muted);text-transform:uppercase;\n  font-size:11px;letter-spacing:.5px;font-weight:800;text-align:left;padding:9px 11px;white-space:nowrap;\n  cursor:pointer;border-bottom:1px solid var(--line);z-index:1}\n.grid thead th.num{text-align:right}\n.grid thead th:hover{color:var(--txt)}\n.grid thead th .arr{color:var(--accent);margin-left:3px;font-size:10px}\n.grid tbody td{padding:8px 11px;border-bottom:1px solid rgba(38,50,74,.6);font-size:13px;vertical-align:middle}\n.grid tbody tr:nth-child(even) td{background:rgba(255,255,255,.015)}\n.grid tbody tr:hover td{background:rgba(56,189,248,.06)}\n.c-mat{font-weight:800;white-space:nowrap}\n.c-obs{display:block;font-size:11px;color:var(--muted2);font-style:italic;font-weight:400;margin-top:1px}\n.c-rama,.c-sub{color:var(--muted);white-space:nowrap}\n.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}\n.n-strong{font-weight:800}\n.n-falta{color:var(--danger);font-weight:800}\n.n-zero{color:var(--muted2)}\n.est{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:800;white-space:nowrap}\n.est .dot{width:9px;height:9px;border-radius:50%}\n.est.rojo{color:#fca5a5}.est.rojo .dot{background:var(--danger)}\n.est.verde{color:#86efac}.est.verde .dot{background:var(--ok)}\n.est.azul{color:#7dd3fc}.est.azul .dot{background:var(--alto)}\n.est.gris{color:#94a3b8}.est.gris .dot{background:var(--gris)}\n.grid tfoot td{padding:10px 11px;border-top:2px solid var(--line);background:var(--head);\n  font-weight:800;font-size:13px}\n.grid tfoot .lbl{color:var(--muted);text-transform:uppercase;font-size:11px;letter-spacing:.5px}\n.empty{padding:26px;text-align:center;color:var(--muted2);font-size:13px}\n</style>\n\n<div class=\"tbl2\" ng-if=\"msg && msg.payload\">\n  <div class=\"tbl2-head\">\n    <div class=\"tbl2-title\">Stock vs mínimo — por material\n      <small>Planilla derivada del criterio. Ordená tocando el encabezado; filtrá arriba.</small>\n    </div>\n    <div class=\"tbl2-mes\">📅 {{msg.payload.mesKey}}</div>\n  </div>\n\n  <div class=\"toolbar\">\n    <input type=\"text\" ng-model=\"tf.q\" placeholder=\"🔍 Buscar material, rama, familia, obs...\">\n    <select ng-model=\"tf.ramaF\" ng-options=\"pt.id as pt.nombre for pt in msg.payload.productosTerminados\">\n      <option value=\"\">Todas las ramas</option>\n    </select>\n    <label class=\"chk\"><input type=\"checkbox\" ng-model=\"tf.soloFalt\"> Solo faltantes</label>\n    <span class=\"count\"><b>{{tablaRows().length}}</b> materiales · stock <b>{{tablaTot('stockTn') | number:1}}</b> tn · falta <b class=\"rd\">{{tablaTot('deficitTn') | number:1}}</b> tn</span>\n  </div>\n\n  <div class=\"tbl-wrap\">\n    <table class=\"grid\">\n      <thead>\n        <tr>\n          <th ng-click=\"tsetSort('productoNombre')\">Rama <span class=\"arr\" ng-if=\"tf.sortCol=='productoNombre'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th ng-click=\"tsetSort('subramaNombre')\">Subrama <span class=\"arr\" ng-if=\"tf.sortCol=='subramaNombre'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th ng-click=\"tsetSort('material')\">Material <span class=\"arr\" ng-if=\"tf.sortCol=='material'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th class=\"num\" ng-click=\"tsetSort('stockTn')\">Stock <span class=\"arr\" ng-if=\"tf.sortCol=='stockTn'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th class=\"num\" ng-click=\"tsetSort('minimoTn')\">Mín <span class=\"arr\" ng-if=\"tf.sortCol=='minimoTn'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th class=\"num\" ng-click=\"tsetSort('maximoTn')\">Máx <span class=\"arr\" ng-if=\"tf.sortCol=='maximoTn'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th class=\"num\" ng-click=\"tsetSort('deficitTn')\">Falta <span class=\"arr\" ng-if=\"tf.sortCol=='deficitTn'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n          <th ng-click=\"tsetSort('estado')\">Estado <span class=\"arr\" ng-if=\"tf.sortCol=='estado'\">{{tf.sortDir>0?'▲':'▼'}}</span></th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr ng-repeat=\"m in tablaRows() track by (m.productoId + '|' + m.subramaId + '|' + m.material)\">\n          <td class=\"c-rama\">{{m.productoId}} · {{m.productoNombre}}</td>\n          <td class=\"c-sub\">{{m.subramaNombre}}</td>\n          <td><span class=\"c-mat\">{{m.material}}</span><span class=\"c-obs\" ng-if=\"m.obs\">{{m.obs}}</span></td>\n          <td class=\"num n-strong\">{{m.stockTn | number:1}}</td>\n          <td class=\"num\" ng-class=\"{'n-zero':!(m.minimoTn>0)}\">{{m.minimoTn | number:1}}</td>\n          <td class=\"num\" ng-class=\"{'n-zero':!(m.maximoTn>0)}\">{{m.maximoTn | number:1}}</td>\n          <td class=\"num\" ng-class=\"m.deficitTn>0?'n-falta':'n-zero'\">{{m.deficitTn>0 ? (m.deficitTn | number:1) : '—'}}</td>\n          <td><span class=\"est\" ng-class=\"tEstCls(m)\"><i class=\"dot\"></i>{{tEstTxt(m)}}</span></td>\n        </tr>\n        <tr ng-if=\"!tablaRows().length\"><td colspan=\"8\" class=\"empty\">No hay materiales para este filtro.</td></tr>\n      </tbody>\n      <tfoot>\n        <tr>\n          <td class=\"lbl\" colspan=\"3\">Totales ({{tablaRows().length}} materiales)</td>\n          <td class=\"num\">{{tablaTot('stockTn') | number:1}}</td>\n          <td class=\"num\">{{tablaTot('minimoTn') | number:1}}</td>\n          <td class=\"num\">{{tablaTot('maximoTn') | number:1}}</td>\n          <td class=\"num n-falta\">{{tablaTot('deficitTn') | number:1}}</td>\n          <td></td>\n        </tr>\n      </tfoot>\n    </table>\n  </div>\n</div>\n\n<script>\n(function(scope){\n  // Estado de filtros/orden en UN objeto (con punto) para sobrevivir al scope hijo de ng-if\n  scope.tf = { q:'', ramaF:'', soloFalt:false, sortCol:'deficitTn', sortDir:-1 };\n\n  scope.tsetSort = function(col){\n    var tf = scope.tf;\n    if(tf.sortCol === col){ tf.sortDir = -tf.sortDir; }\n    else { tf.sortCol = col; tf.sortDir = (col==='material'||col==='productoNombre'||col==='subramaNombre'||col==='estado') ? 1 : -1; }\n  };\n\n  scope.tablaRows = function(){\n    var tf = scope.tf;\n    var rows = (scope.msg && scope.msg.payload && scope.msg.payload.stockMapeo) ? scope.msg.payload.stockMapeo : [];\n    var q = (tf.q || '').toString().toLowerCase().trim();\n    var out = rows.filter(function(m){\n      if(tf.soloFalt && !(m.deficitTn > 0)) return false;\n      if(tf.ramaF !== '' && tf.ramaF != null && Number(m.productoId) !== Number(tf.ramaF)) return false;\n      if(q){\n        var hay = ((m.material||'')+' '+(m.productoNombre||'')+' '+(m.subramaNombre||'')+' '+(m.familia||'')+' '+(m.obs||'')).toLowerCase();\n        if(hay.indexOf(q) < 0) return false;\n      }\n      return true;\n    });\n    var c = tf.sortCol, d = tf.sortDir;\n    out = out.slice().sort(function(a,b){\n      var va = a[c], vb = b[c];\n      if(typeof va === 'string' || typeof vb === 'string'){\n        va = (va==null?'':va).toString().toLowerCase(); vb = (vb==null?'':vb).toString().toLowerCase();\n        return va < vb ? -d : (va > vb ? d : 0);\n      }\n      return ((Number(va)||0) - (Number(vb)||0)) * d;\n    });\n    return out;\n  };\n\n  scope.tablaTot = function(campo){\n    return scope.tablaRows().reduce(function(s,m){ return s + (Number(m[campo])||0); }, 0);\n  };\n\n  scope.tEstTxt = function(m){\n    if(!m) return '';\n    if(m.estado === 'critico') return 'FALTA';\n    if(m.estado === 'alto') return 'ALTO';\n    if(m.estado === 'ok') return 'OK';\n    return 'SIN MÍN';\n  };\n  scope.tEstCls = function(m){\n    if(!m) return 'gris';\n    if(m.estado === 'critico') return 'rojo';\n    if(m.estado === 'alto') return 'azul';\n    if(m.estado === 'ok') return 'verde';\n    return 'gris';\n  };\n})(scope);\n</script>\n",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
