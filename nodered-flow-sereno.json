  {
    "id": "fn_result_shared",
    "type": "function",
    "z": "tab_cams_sereno",
    "name": "Verificar resultado exec",
    "func": "const key = msg.camKey;\nconst file = msg.camFile;\nif (!key || !file) return null;\nconst rc = msg.payload;\nconst code = (typeof rc === 'object' && rc !== null) ? rc.code : parseInt(rc, 10);\nconst st = flow.get('camStatus') || {};\nif (!st[key]) st[key] = {name:key, key:key, lastUpdate:null, lastSize:null, status:'unknown', error:null, img:''};\nif (isNaN(code) || code !== 0) {\n  st[key].status = 'error';\n  st[key].error = 'rc:' + code;\n  flow.set('camStatus', st);\n  node.status({fill:'red', shape:'ring', text:'['+key+'] rc:'+code});\n  return null;\n}\nflow.set('camStatus', st);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 900,
    "y": 40,
    "wires": [
      [
        "filein_shared"
      ]
    ]
  },
  {
    "id": "filein_shared",
    "type": "file in",
    "z": "tab_cams_sereno",
    "name": "Leer JPG (buffer)",
    "filename": "camFile",
    "filenameType": "msg",
    "format": "buffer",
    "sendError": false,
    "encoding": "none",
    "allProps": false,
    "x": 1100,
    "y": 40,
    "wires": [
      [
        "fn_store_img"
      ]
    ]
  },
  {
    "id": "fn_store_img",
    "type": "function",
    "z": "tab_cams_sereno",
    "name": "Guardar imagen base64",
    "func": "const key = msg.camKey;\nif (!key) return null;\nconst st = flow.get('camStatus') || {};\nif (!st[key]) return null;\nconst buf = Buffer.isBuffer(msg.payload)\n  ? msg.payload\n  : Buffer.from(msg.payload, 'binary');\nconst size = buf.length;\nif (size < 2000) {\n  st[key].status = 'error';\n  st[key].error = 'jpg chico: ' + size + 'B';\n  flow.set('camStatus', st);\n  node.status({fill:'red', shape:'ring', text:'['+key+'] jpg '+size+'B'});\n  return null;\n}\nst[key].img = buf.toString('base64');\nst[key].lastUpdate = Date.now();\nst[key].lastSize = size;\nst[key].status = 'ok';\nst[key].error = null;\nflow.set('camStatus', st);\nnode.status({fill:'green', shape:'dot', text:'['+key+'] ~'+Math.round(size/1024)+'KB'});\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1320,
    "y": 40,
    "wires": [
      []
    ]
  },
