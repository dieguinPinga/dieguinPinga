  {
    "id": "fn_ui_data",
    "type": "function",
    "z": "tab_cams_sereno",
    "name": "Armar datos UI",
    "func": "const status = flow.get('camStatus') || {};\nconst keys = [\"play2\", \"prod1\", \"adentro\", \"cam190\", \"cam151\", \"cam67\", \"cam64\", \"bal1_afuera\", \"pt_galpon\", \"molino_chino\", \"fondo\", \"camcom2\", \"playon1\", \"cam96\"];\nconst names = {\"play2\": \"Play2\", \"prod1\": \"Produccion1\", \"adentro\": \"Adentro\", \"cam190\": \"CAM190\", \"cam151\": \"CAM151\", \"cam67\": \"CAM67\", \"cam64\": \"CAM64\", \"bal1_afuera\": \"BAL1 Afuera\", \"pt_galpon\": \"PT Galpon\", \"molino_chino\": \"Molino Chino\", \"fondo\": \"Fondo\", \"camcom2\": \"CamCom2\", \"playon1\": \"Playon1\", \"cam96\": \"CAM96\"};\nconst now = Date.now();\nconst OLD_SEC = 90;\nmsg.payload = keys.map(k => {\n  const s = status[k] || {};\n  const age = s.lastUpdate ? Math.floor((now - s.lastUpdate) / 1000) : null;\n  let st = s.status || 'unknown';\n  if (st === 'ok' && age !== null && age > OLD_SEC) st = 'old';\n  let txt;\n  if (age !== null) {\n    if (st === 'error') txt = 'Error (hace ' + age + 's)';\n    else if (st === 'old') txt = 'Vieja (hace ' + age + 's)';\n    else txt = 'Hace ' + age + 's';\n  } else {\n    txt = st === 'error' ? ('Error: ' + (s.error || '')) : 'Sin datos';\n  }\n  const kb = s.lastSize ? Math.round(s.lastSize / 1024) + ' KB' : '--';\n  return { key: k, name: names[k] || k, status: st, statusText: txt, sizeText: kb, img: s.img || '' };\n});\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 1320,
    "wires": [
      [
        "ui_tpl"
      ]
    ]
  },
  {
    "id": "ui_tpl",
    "type": "ui_template",
    "z": "tab_cams_sereno",
    "group": "uigrp_cams",
    "name": "Grilla Camaras",
    "order": 1,
    "width": "24",
    "height": "20",
    "format": "<style>\n.sg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px;background:#111}\n@media(max-width:800px){.sg-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:500px){.sg-grid{grid-template-columns:1fr}}\n.sg-card{border:2px solid #555;border-radius:6px;overflow:hidden;background:#1e1e1e;font-family:sans-serif}\n.sg-card.ok{border-color:#4caf50}.sg-card.old{border-color:#ff9800}.sg-card.error{border-color:#f44336}.sg-card.unknown{border-color:#616161}\n.sg-img{width:100%;height:140px;object-fit:cover;display:block;background:#000}\n.sg-noimg{width:100%;height:140px;background:#111;display:flex;align-items:center;justify-content:center;color:#444;font-size:11px}\n.sg-info{padding:5px 8px;color:#eee;font-size:11px;line-height:1.6}\n.sg-name{font-size:13px;font-weight:bold;display:flex;align-items:center;gap:6px;margin-bottom:2px}\n.sg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;display:inline-block}\n.dot-ok{background:#4caf50}.dot-old{background:#ff9800}.dot-error{background:#f44336}.dot-unknown{background:#9e9e9e}\n.sg-stat{color:#aaa;font-size:10px}\n</style>\n<div class=\"sg-grid\">\n  <div ng-repeat=\"cam in msg.payload track by cam.key\" class=\"sg-card\" ng-class=\"cam.status\">\n    <img class=\"sg-img\" ng-if=\"cam.img\" ng-src=\"'data:image/jpeg;base64,'+cam.img\" alt=\"{{cam.name}}\">\n    <div class=\"sg-noimg\" ng-if=\"!cam.img\">sin imagen</div>\n    <div class=\"sg-info\">\n      <div class=\"sg-name\"><span class=\"sg-dot\" ng-class=\"'dot-'+cam.status\"></span>{{cam.name}}</div>\n      <div class=\"sg-stat\">{{cam.statusText}} &bull; {{cam.sizeText}}</div>\n    </div>\n  </div>\n</div>",
    "storeOutMessages": false,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 570,
    "y": 1320,
    "wires": [
      []
    ]
  }
